{
  "track": "reassembling",
  "durationSec": 161.2,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 9.26,
      "endSec": 11.65,
      "text": "Я снова прокручиваю мысли по кругу."
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 11.65,
      "endSec": 14.36,
      "text": "I'm ruminating again, thoughts going in circles."
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 14.36,
      "endSec": 16.75,
      "text": "Каждая мелочь вырастает в катастрофу."
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 16.75,
      "endSec": 19.47,
      "text": "Every little thing balloons into a catastrophe."
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 19.47,
      "endSec": 21.7,
      "text": "Я зову это бдительностью, а не страхом,"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 21.7,
      "endSec": 23.78,
      "text": "I call it vigilance rather than fear,"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 23.78,
      "endSec": 26.01,
      "text": "хотя давно знаю, что это уловка."
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 26.01,
      "endSec": 28.48,
      "text": "though I've known for ages it's a ploy."
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 28.48,
      "endSec": 30.88,
      "text": "Я прячусь в делах, чтобы не слышать себя."
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 30.88,
      "endSec": 33.27,
      "text": "I hide in my tasks so I won't hear myself."
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 33.27,
      "endSec": 35.51,
      "text": "Тишина пугает громче любого крика."
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 35.51,
      "endSec": 38.14,
      "text": "Silence scares me louder than any scream."
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 38.14,
      "endSec": 40.37,
      "text": "Но осознать — уже половина дела."
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 40.37,
      "endSec": 43.24,
      "text": "But becoming aware is already half the battle."
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 43.24,
      "endSec": 45.56,
      "text": "Я не обязан побеждать — только понять,"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 45.56,
      "endSec": 47.79,
      "text": "I don't have to win — only to understand,"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 47.79,
      "endSec": 50.19,
      "text": "побыть со своим дискомфортом, не отпрянув,"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 50.19,
      "endSec": 52.58,
      "text": "to sit with my discomfort without recoiling"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 52.58,
      "endSec": 54.73,
      "text": "и перестать с собой воевать."
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 54.73,
      "endSec": 57.85,
      "text": "and stop waging war on myself."
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 57.85,
      "endSec": 59.92,
      "text": "Я не сломан, я просто в процессе."
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 59.92,
      "endSec": 62.31,
      "text": "I'm not broken, I'm just a work in progress."
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 62.31,
      "endSec": 64.71,
      "text": "Каждая трещина — часть моей истории."
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 64.71,
      "endSec": 67.1,
      "text": "Every crack is part of my narrative."
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 67.1,
      "endSec": 69.18,
      "text": "Я учусь не прятать то, что болит,"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 69.18,
      "endSec": 71.65,
      "text": "I'm learning not to conceal what hurts"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 71.65,
      "endSec": 74.04,
      "text": "и не называть слабостью честность."
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 74.04,
      "endSec": 76.83,
      "text": "and not to label honesty as weakness."
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 76.83,
      "endSec": 78.91,
      "text": "Пусть путь неровный — он всё равно мой."
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 78.91,
      "endSec": 81.38,
      "text": "Let the path be uneven — it's mine all the same."
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 81.38,
      "endSec": 83.38,
      "text": "Я больше не торгуюсь с тревогой:"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 83.38,
      "endSec": 86.17,
      "text": "I no longer bargain with my anxiety:"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 86.17,
      "endSec": 88.56,
      "text": "я слушаю её и не иду на поводу,"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 88.56,
      "endSec": 91.52,
      "text": "I hear it out, but I won't be led by it,"
    },
    {
      "index": 34,
      "line": 18,
      "lang": "ru",
      "startSec": 91.52,
      "endSec": 93.59,
      "text": "и это само по себе — сила."
    },
    {
      "index": 35,
      "line": 18,
      "lang": "en",
      "startSec": 93.59,
      "endSec": 96.46,
      "text": "and that, in and of itself, is strength."
    },
    {
      "index": 36,
      "line": 19,
      "lang": "ru",
      "startSec": 96.46,
      "endSec": 98.46,
      "text": "Раньше я винил себя за каждый промах."
    },
    {
      "index": 37,
      "line": 19,
      "lang": "en",
      "startSec": 98.46,
      "endSec": 100.85,
      "text": "I used to blame myself for every misstep."
    },
    {
      "index": 38,
      "line": 20,
      "lang": "ru",
      "startSec": 100.85,
      "endSec": 103.17,
      "text": "Теперь я отличаю критика от правды."
    },
    {
      "index": 39,
      "line": 20,
      "lang": "en",
      "startSec": 103.17,
      "endSec": 105.96,
      "text": "Now I can tell the critic from the truth."
    },
    {
      "index": 40,
      "line": 21,
      "lang": "ru",
      "startSec": 105.96,
      "endSec": 107.95,
      "text": "Я больше не стыжусь просить о помощи."
    },
    {
      "index": 41,
      "line": 21,
      "lang": "en",
      "startSec": 107.95,
      "endSec": 110.5,
      "text": "I'm no longer ashamed to ask for help."
    },
    {
      "index": 42,
      "line": 22,
      "lang": "ru",
      "startSec": 110.5,
      "endSec": 112.74,
      "text": "Ведь опереться на других — не значит рухнуть."
    },
    {
      "index": 43,
      "line": 22,
      "lang": "en",
      "startSec": 112.74,
      "endSec": 115.45,
      "text": "Leaning on others doesn't mean I'll collapse."
    },
    {
      "index": 44,
      "line": 23,
      "lang": "ru",
      "startSec": 115.45,
      "endSec": 118.17,
      "text": "Я не сломан — я собираю себя заново."
    },
    {
      "index": 45,
      "line": 23,
      "lang": "en",
      "startSec": 118.17,
      "endSec": 120.72,
      "text": "I'm not broken — I'm reassembling myself."
    },
    {
      "index": 46,
      "line": 24,
      "lang": "ru",
      "startSec": 120.72,
      "endSec": 123.03,
      "text": "Каждая трещина стала частью узора."
    },
    {
      "index": 47,
      "line": 24,
      "lang": "en",
      "startSec": 123.03,
      "endSec": 125.43,
      "text": "Every crack has become part of the pattern."
    },
    {
      "index": 48,
      "line": 25,
      "lang": "ru",
      "startSec": 125.43,
      "endSec": 127.5,
      "text": "Я слышу тревогу, но выбираю сам."
    },
    {
      "index": 49,
      "line": 25,
      "lang": "en",
      "startSec": 127.5,
      "endSec": 130.21,
      "text": "I hear the anxiety, but the choice is mine."
    },
    {
      "index": 50,
      "line": 26,
      "lang": "ru",
      "startSec": 130.21,
      "endSec": 132.85,
      "text": "И тишина больше не звучит как приговор."
    },
    {
      "index": 51,
      "line": 26,
      "lang": "en",
      "startSec": 132.85,
      "endSec": 136.28,
      "text": "And silence no longer sounds like a verdict."
    },
    {
      "index": 52,
      "line": 27,
      "lang": "ru",
      "startSec": 136.28,
      "endSec": 138.19,
      "text": "Я признаю усталость без стыда."
    },
    {
      "index": 53,
      "line": 27,
      "lang": "en",
      "startSec": 138.19,
      "endSec": 140.66,
      "text": "I admit my exhaustion without shame."
    },
    {
      "index": 54,
      "line": 28,
      "lang": "ru",
      "startSec": 140.66,
      "endSec": 142.98,
      "text": "Исцеление — не прямая, а спираль,"
    },
    {
      "index": 55,
      "line": 28,
      "lang": "en",
      "startSec": 142.98,
      "endSec": 145.77,
      "text": "Healing is no straight line, but a spiral,"
    },
    {
      "index": 56,
      "line": 29,
      "lang": "ru",
      "startSec": 145.77,
      "endSec": 147.93,
      "text": "и каждый круг ведёт меня выше."
    },
    {
      "index": 57,
      "line": 29,
      "lang": "en",
      "startSec": 147.93,
      "endSec": 150.72,
      "text": "and each turn still carries me higher."
    },
    {
      "index": 58,
      "line": 30,
      "lang": "ru",
      "startSec": 150.72,
      "endSec": 154.15,
      "text": "Не всегда быть в порядке — в порядке вещей."
    },
    {
      "index": 59,
      "line": 30,
      "lang": "en",
      "startSec": 154.15,
      "endSec": 161.2,
      "text": "Not being okay all the time is only natural."
    }
  ],
