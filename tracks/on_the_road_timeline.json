{
  "track": "on_the_road",
  "durationSec": 93.56,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 1.44,
      "endSec": 5.75,
      "text": "Я собираю вещи с утра"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 5.75,
      "endSec": 9.97,
      "text": "I pack my things in the morning"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 9.97,
      "endSec": 13.24,
      "text": "Кладу паспорт и билет"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 13.24,
      "endSec": 18.51,
      "text": "I put my passport and ticket in"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 18.51,
      "endSec": 20.75,
      "text": "Мой поезд через десять минут"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 20.75,
      "endSec": 22.82,
      "text": "My train leaves in ten minutes"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 22.82,
      "endSec": 24.97,
      "text": "Надо быстро найти платформу"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 24.97,
      "endSec": 29.36,
      "text": "I need to find the platform quickly"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 29.36,
      "endSec": 32.31,
      "text": "Я в дороге, новый город впереди"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 32.31,
      "endSec": 37.9,
      "text": "I'm on the road, a new city ahead"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 37.9,
      "endSec": 39.89,
      "text": "Я не знаю, что там будет"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 39.89,
      "endSec": 41.89,
      "text": "I don't know what will happen there"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 41.89,
      "endSec": 44.28,
      "text": "Но я хочу всё увидеть"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 44.28,
      "endSec": 46.36,
      "text": "But I want to see it all"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 46.36,
      "endSec": 49.55,
      "text": "Каждый день приносит что-то новое"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 49.55,
      "endSec": 53.46,
      "text": "Every day brings something new"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 53.46,
      "endSec": 55.77,
      "text": "Я приезжаю в другой город"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 55.77,
      "endSec": 57.61,
      "text": "I arrive in another city"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 57.61,
      "endSec": 59.84,
      "text": "Я беру такси до отеля"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 59.84,
      "endSec": 61.91,
      "text": "I take a taxi to the hotel"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 61.91,
      "endSec": 64.15,
      "text": "Я захожу в маленькое кафе"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 64.15,
      "endSec": 66.38,
      "text": "I go into a small cafe"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 66.38,
      "endSec": 68.54,
      "text": "Усталый, но очень довольный"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 68.54,
      "endSec": 71.65,
      "text": "Tired, but very happy"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 71.65,
      "endSec": 74.6,
      "text": "Я в дороге, и мне нравится путь"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 74.6,
      "endSec": 80.11,
      "text": "I'm on the road, and I like the journey"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 80.11,
      "endSec": 81.7,
      "text": "Завтра новый день"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 81.7,
      "endSec": 84.25,
      "text": "Tomorrow is a new day"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 84.25,
      "endSec": 86.17,
      "text": "Новый маршрут впереди"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 86.17,
      "endSec": 88.25,
      "text": "A new route is ahead"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 88.25,
      "endSec": 90.4,
      "text": "И снова выхожу в путь"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 90.4,
      "endSec": 93.56,
      "text": "And hit the road again"
    }
  ],
