{
  "track": "dino_dance",
  "durationSec": 110.0,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 2.71,
      "endSec": 5.03,
      "text": "Динозавры, выходите!"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 5.03,
      "endSec": 7.26,
      "text": "Dinosaurs, come out!"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 7.26,
      "endSec": 9.97,
      "text": "Будем танцевать!"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 9.97,
      "endSec": 11.65,
      "text": "Let’s dance!"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 11.65,
      "endSec": 12.77,
      "text": "Топай лапами!"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 12.77,
      "endSec": 13.72,
      "text": "Stomp your feet!"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 13.72,
      "endSec": 15.0,
      "text": "Хлопай в ладоши!"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 15.0,
      "endSec": 16.12,
      "text": "Clap your hands!"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 16.12,
      "endSec": 17.23,
      "text": "Повернись!"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 17.23,
      "endSec": 18.35,
      "text": "Turn around!"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 18.35,
      "endSec": 19.47,
      "text": "Покружись!"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 19.47,
      "endSec": 20.35,
      "text": "Spin around!"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 20.35,
      "endSec": 21.78,
      "text": "Тряси хвостом!"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 21.78,
      "endSec": 22.74,
      "text": "Shake your tail!"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 22.74,
      "endSec": 24.02,
      "text": "Прыгай вверх!"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 24.02,
      "endSec": 25.13,
      "text": "Jump up high!"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 25.13,
      "endSec": 27.37,
      "text": "Дино-танец, раз, два, три!"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 27.37,
      "endSec": 29.52,
      "text": "Dino dance, one, two, three!"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 29.52,
      "endSec": 31.12,
      "text": "Прыгай высоко!"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 31.12,
      "endSec": 33.35,
      "text": "Jump up high!"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 33.35,
      "endSec": 35.11,
      "text": "Топай: топ-топ-топ!"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 35.11,
      "endSec": 35.98,
      "text": "Stomp, stomp, stomp!"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 35.98,
      "endSec": 37.34,
      "text": "Замри на месте!"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 37.34,
      "endSec": 38.3,
      "text": "Freeze in place!"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 38.3,
      "endSec": 40.37,
      "text": "Тираннозавр рычит!"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 40.37,
      "endSec": 42.53,
      "text": "The T. rex roars!"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 42.53,
      "endSec": 44.28,
      "text": "Трицератопс топает!"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 44.28,
      "endSec": 46.68,
      "text": "The Triceratops stomps!"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 46.68,
      "endSec": 48.75,
      "text": "Диплодок тянет шею!"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 48.75,
      "endSec": 51.14,
      "text": "Diplodocus stretches its neck!"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 51.14,
      "endSec": 53.38,
      "text": "Маленький динозавр прыгает!"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 53.38,
      "endSec": 56.33,
      "text": "The little dinosaur jumps!"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 56.33,
      "endSec": 58.48,
      "text": "Дино-танец, раз, два, три!"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 58.48,
      "endSec": 60.56,
      "text": "Dino dance, one, two, three!"
    },
    {
      "index": 34,
      "line": 18,
      "lang": "ru",
      "startSec": 60.56,
      "endSec": 62.23,
      "text": "Прыгай высоко!"
    },
    {
      "index": 35,
      "line": 18,
      "lang": "en",
      "startSec": 62.23,
      "endSec": 64.55,
      "text": "Jump up high!"
    },
    {
      "index": 36,
      "line": 19,
      "lang": "ru",
      "startSec": 64.55,
      "endSec": 66.14,
      "text": "Топай: топ-топ-топ!"
    },
    {
      "index": 37,
      "line": 19,
      "lang": "en",
      "startSec": 66.14,
      "endSec": 67.1,
      "text": "Stomp, stomp, stomp!"
    },
    {
      "index": 38,
      "line": 20,
      "lang": "ru",
      "startSec": 67.1,
      "endSec": 68.38,
      "text": "Замри на месте!"
    },
    {
      "index": 39,
      "line": 20,
      "lang": "en",
      "startSec": 68.38,
      "endSec": 69.25,
      "text": "Freeze in place!"
    },
    {
      "index": 40,
      "line": 21,
      "lang": "ru",
      "startSec": 69.25,
      "endSec": 70.61,
      "text": "Замри на месте!"
    },
    {
      "index": 41,
      "line": 21,
      "lang": "en",
      "startSec": 70.61,
      "endSec": 73.08,
      "text": "Freeze in place!"
    },
    {
      "index": 42,
      "line": 22,
      "lang": "ru",
      "startSec": 73.08,
      "endSec": 74.52,
      "text": "Не двигайся!"
    },
    {
      "index": 43,
      "line": 22,
      "lang": "en",
      "startSec": 74.52,
      "endSec": 75.4,
      "text": "Don’t move!"
    },
    {
      "index": 44,
      "line": 23,
      "lang": "ru",
      "startSec": 75.4,
      "endSec": 76.44,
      "text": "Медленно шагай!"
    },
    {
      "index": 45,
      "line": 23,
      "lang": "en",
      "startSec": 76.44,
      "endSec": 77.63,
      "text": "Walk slowly!"
    },
    {
      "index": 46,
      "line": 24,
      "lang": "ru",
      "startSec": 77.63,
      "endSec": 78.91,
      "text": "Быстро прыгай!"
    },
    {
      "index": 47,
      "line": 24,
