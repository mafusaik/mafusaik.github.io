{
  "track": "at_a_restaurant",
  "durationSec": 199.6,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 12.57,
      "endSec": 15.77,
      "text": "Я захожу в кафе и сажусь за столик"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 15.77,
      "endSec": 19.17,
      "text": "I go into the café and sit at a table"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 19.17,
      "endSec": 20.73,
      "text": "Я смотрю на меню"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 20.73,
      "endSec": 22.37,
      "text": "I look at the menu"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 22.37,
      "endSec": 25.57,
      "text": "Здесь много хороших блюд"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 25.57,
      "endSec": 28.9,
      "text": "There are many good dishes here"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 28.9,
      "endSec": 31.17,
      "text": "Я не знаю, что выбрать"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 31.17,
      "endSec": 34.53,
      "text": "I don’t know what to choose"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 34.53,
      "endSec": 36.67,
      "text": "Что вы порекомендуете?"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 36.67,
      "endSec": 38.8,
      "text": "What do you recommend?"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 38.8,
      "endSec": 41.67,
      "text": "Я хотел бы заказать это блюдо"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 41.67,
      "endSec": 44.63,
      "text": "I would like to order this dish"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 44.63,
      "endSec": 48.03,
      "text": "Можно, пожалуйста, стакан воды?"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 48.03,
      "endSec": 51.0,
      "text": "Can I have a glass of water, please?"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 51.0,
      "endSec": 54.1,
      "text": "Спасибо, всё хорошо"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 54.1,
      "endSec": 58.03,
      "text": "Thank you, everything is fine"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 58.03,
      "endSec": 61.27,
      "text": "Официант подходит к моему столу"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 61.27,
      "endSec": 64.57,
      "text": "The waiter comes to my table"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 64.57,
      "endSec": 66.23,
      "text": "Я готов сделать заказ"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 66.23,
      "endSec": 67.97,
      "text": "I am ready to order"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 67.97,
      "endSec": 70.2,
      "text": "Я возьму суп и салат"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 70.2,
      "endSec": 72.83,
      "text": "I’ll have soup and a salad"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 72.83,
      "endSec": 75.23,
      "text": "И, пожалуйста, чашку кофе"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 75.23,
      "endSec": 78.37,
      "text": "And a cup of coffee, please"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 78.37,
      "endSec": 80.47,
      "text": "Что вы порекомендуете?"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 80.47,
      "endSec": 82.6,
      "text": "What do you recommend?"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 82.6,
      "endSec": 85.33,
      "text": "Я хотел бы заказать это блюдо"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 85.33,
      "endSec": 88.43,
      "text": "I would like to order this dish"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 88.43,
      "endSec": 91.83,
      "text": "Можно, пожалуйста, стакан воды?"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 91.83,
      "endSec": 94.77,
      "text": "Can I have a glass of water, please?"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 94.77,
      "endSec": 97.9,
      "text": "Спасибо, всё хорошо"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 97.9,
      "endSec": 102.63,
      "text": "Thank you, everything is fine"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 102.63,
      "endSec": 105.23,
      "text": "Можно мне ещё немного хлеба?"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 105.23,
      "endSec": 108.23,
      "text": "Can I have some more bread?"
    },
    {
      "index": 34,
      "line": 18,
      "lang": "ru",
      "startSec": 108.23,
      "endSec": 110.67,
      "text": "Можно без лука, пожалуйста?"
    },
    {
      "index": 35,
      "line": 18,
      "lang": "en",
      "startSec": 110.67,
      "endSec": 114.67,
      "text": "Can I have it without onions, please?"
    },
    {
      "index": 36,
      "line": 19,
      "lang": "ru",
      "startSec": 114.67,
      "endSec": 117.33,
      "text": "Сколько времени займёт заказ?"
    },
    {
      "index": 37,
      "line": 19,
      "lang": "en",
      "startSec": 117.33,
      "endSec": 121.17,
      "text": "How long will the order take?"
    },
    {
      "index": 38,
      "line": 20,
      "lang": "ru",
      "startSec": 121.17,
      "endSec": 124.67,
      "text": "Хорошо, я подожду"
    },
    {
      "index": 39,
      "line": 20,
      "lang": "en",
      "startSec": 124.67,
      "endSec": 127.83,
      "text": "Okay, I will wait"
    },
    {
      "index": 40,
      "line": 21,
      "lang": "ru",
      "startSec": 127.83,
      "endSec": 130.57,
      "text": "Еда выглядит очень вкусно"
    },
    {
      "index": 41,
      "line": 21,
      "lang": "en",
      "startSec": 130.57,
      "endSec": 133.77,
      "text": "The food looks very good"
    },
    {
      "index": 42,
      "line": 22,
      "lang": "ru",
      "startSec": 133.77,
      "endSec": 136.23,
      "text": "Мне нравится этот суп"
    },
    {
      "index": 43,
      "line": 22,
      "lang": "en",
      "startSec": 136.23,
      "endSec": 139.73,
      "text": "I like this soup"
    },
    {
      "index": 44,
      "line": 23,
      "lang": "ru",
      "startSec": 139.73,
      "endSec": 142.53,
      "text": "Всё очень вкусно и свежее"
    },
    {
      "index": 45,
      "line": 23,
      "lang": "en",
      "startSec": 142.53,
      "endSec": 145.77,
      "text": "Everything is very tasty and fresh"
    },
    {
      "index": 46,
      "line": 24,
      "lang": "ru",
      "startSec": 145.77,
      "endSec": 148.43,
      "text": "Спасибо, я хорошо поел"
    },
    {
      "index": 47,
      "line": 24,
      "lang": "en",
      "startSec": 148.43,
      "endSec": 153.57,
      "text": "Thank you, I had a good meal"
    },
    {
      "index": 48,
      "line": 25,
      "lang": "ru",
      "startSec": 153.57,
      "endSec": 155.13,
      "text": "Официант приносит счёт"
    },
    {
      "index": 49,
      "line": 25,
      "lang": "en",
      "startSec": 155.13,
      "endSec": 156.7,
      "text": "The waiter brings the bill"
    },
    {
      "index": 50,
      "line": 26,
      "lang": "ru",
      "startSec": 156.7,
      "endSec": 158.47,
      "text": "Можно счёт, пожалуйста?"
    },
    {
      "index": 51,
      "line": 26,
      "lang": "en",
      "startSec": 158.47,
      "endSec": 160.47,
      "text": "Can I have the bill, please?"
    },
    {
      "index": 52,
      "line": 27,
      "lang": "ru",
      "startSec": 160.47,
      "endSec": 162.47,
      "text": "Можно оплатить картой?"
    },
    {
      "index": 53,
      "line": 27,
      "lang": "en",
      "startSec": 162.47,
      "endSec": 163.83,
      "text": "Can I pay by card?"
    },
    {
      "index": 54,
      "line": 28,
      "lang": "ru",
      "startSec": 163.83,
      "endSec": 166.87,
      "text": "Спасибо за хороший вечер"
    },
    {
      "index": 55,
      "line": 28,
      "lang": "en",
      "startSec": 166.87,
      "endSec": 169.1,
      "text": "Thank you for a nice evening"
    },
    {
      "index": 56,
      "line": 29,
      "lang": "ru",
      "startSec": 169.1,
      "endSec": 172.47,
      "text": "Мне очень понравилась еда"
    },
    {
      "index": 57,
      "line": 29,
      "lang": "en",
      "startSec": 172.47,
      "endSec": 175.23,
      "text": "I really enjoyed the food"
    },
    {
      "index": 58,
      "line": 30,
      "lang": "ru",
      "startSec": 175.23,
      "endSec": 179.73,
      "text": "Мне понравилось это кафе"
    },
    {
      "index": 59,
      "line": 30,
      "lang": "en",
      "startSec": 179.73,
      "endSec": 181.77,
      "text": "I liked this café"
    },
    {
      "index": 60,
      "line": 31,
      "lang": "ru",
      "startSec": 181.77,
      "endSec": 185.23,
      "text": "Я обязательно вернусь сюда снова"
    },
    {
      "index": 61,
      "line": 31,
      "lang": "en",
      "startSec": 185.23,
      "endSec": 188.4,
      "text": "I will definitely come back here again"
    },
    {
      "index": 62,
      "line": 32,
      "lang": "ru",
      "startSec": 188.4,
      "endSec": 191.53,
      "text": "Спасибо, до свидания!"
    },
    {
      "index": 63,
      "line": 32,
      "lang": "en",
      "startSec": 191.53,
      "endSec": 199.6,
      "text": "Thank you, goodbye!"
    }
  ],
