{
  "track": "at_a_restaurant",
  "durationSec": 77.6,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 1.2,
      "endSec": 2.79,
      "text": "Я сажусь за столик в кафе"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 2.79,
      "endSec": 5.5,
      "text": "I sit down at a table in a café"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 5.5,
      "endSec": 6.78,
      "text": "Я смотрю на меню"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 6.78,
      "endSec": 8.14,
      "text": "I look at the menu"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 8.14,
      "endSec": 9.57,
      "text": "Я не знаю, что выбрать"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 9.57,
      "endSec": 11.33,
      "text": "I don’t know what to choose"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 11.33,
      "endSec": 14.04,
      "text": "Что вы порекомендуете?"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 14.04,
      "endSec": 15.96,
      "text": "What do you recommend?"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 15.96,
      "endSec": 18.99,
      "text": "Я хочу попробовать что-то новое"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 18.99,
      "endSec": 21.38,
      "text": "I want to try something new"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 21.38,
      "endSec": 23.22,
      "text": "Я не люблю острое"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 23.22,
      "endSec": 25.21,
      "text": "I don’t like spicy food"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 25.21,
      "endSec": 27.21,
      "text": "Я готов сделать заказ"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 27.21,
      "endSec": 29.52,
      "text": "I’m ready to order"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 29.52,
      "endSec": 32.0,
      "text": "Я возьму пасту и салат"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 32.0,
      "endSec": 34.95,
      "text": "I’ll have pasta and a salad"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 34.95,
      "endSec": 37.42,
      "text": "Можно, пожалуйста, стакан воды?"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 37.42,
      "endSec": 41.09,
      "text": "Could I have a glass of water, please?"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 41.09,
      "endSec": 43.8,
      "text": "Что вы порекомендуете?"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 43.8,
      "endSec": 45.88,
      "text": "What do you recommend?"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 45.88,
      "endSec": 48.83,
      "text": "Я хочу попробовать что-то новое"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 48.83,
      "endSec": 51.22,
      "text": "I want to try something new"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 51.22,
      "endSec": 53.06,
      "text": "Я не люблю острое"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 53.06,
      "endSec": 55.05,
      "text": "I don’t like spicy food"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 55.05,
      "endSec": 56.81,
      "text": "Можно счёт, пожалуйста?"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 56.81,
      "endSec": 59.36,
      "text": "Can I have the bill, please?"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 59.36,
      "endSec": 61.52,
      "text": "Можно оплатить картой?"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 61.52,
      "endSec": 64.79,
      "text": "Could I pay by card?"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 64.79,
      "endSec": 67.66,
      "text": "Спасибо за хороший вечер"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 67.66,
      "endSec": 70.53,
      "text": "Thank you for a nice evening"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 70.53,
      "endSec": 72.85,
      "text": "Я обязательно вернусь снова"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 72.85,
      "endSec": 77.6,
      "text": "I will definitely come back again"
    }
  ],
