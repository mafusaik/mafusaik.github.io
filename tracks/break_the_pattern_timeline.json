{
  "track": "break_the_pattern",
  "durationSec": 215.16,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 2.55,
      "endSec": 6.22,
      "text": "Я больше не хочу играть чужую роль"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 6.22,
      "endSec": 9.89,
      "text": "I’m done with playing someone else’s role"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 9.89,
      "endSec": 13.01,
      "text": "Я выбираю сам, каким мне быть"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 13.01,
      "endSec": 23.0,
      "text": "I’ll choose for myself who I want to be"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 30.64,
      "endSec": 33.83,
      "text": "Я подгонял себя под чей-то идеал"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 33.83,
      "endSec": 37.58,
      "text": "I tried to fit the image they had planned"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 37.58,
      "endSec": 41.25,
      "text": "Боялся потерять то, что ещё не потерял"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 41.25,
      "endSec": 44.92,
      "text": "I feared losing things I didn’t even have"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 44.92,
      "endSec": 48.19,
      "text": "Но если каждый шаг диктует чей-то страх"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 48.19,
      "endSec": 52.26,
      "text": "If every step is guided by someone else’s fear"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 52.26,
      "endSec": 55.93,
      "text": "То как узнать, куда ведёт мой путь?"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 55.93,
      "endSec": 60.08,
      "text": "Then how can I discover my own path?"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 60.08,
      "endSec": 63.59,
      "text": "Я не обязан знать, кем стану завтра"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 63.59,
      "endSec": 67.42,
      "text": "I don’t have to know who I’ll become"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 67.42,
      "endSec": 70.69,
      "text": "Но я могу решить, кем больше не быть"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 70.69,
      "endSec": 74.84,
      "text": "But I can decide who I won’t be again"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 74.84,
      "endSec": 77.55,
      "text": "Пускай привычный мир теряет власть"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 77.55,
      "endSec": 81.22,
      "text": "Let the familiar world lose its hold on me"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 81.22,
      "endSec": 85.21,
      "text": "Я начинаю всё с другой страницы"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 85.21,
      "endSec": 89.44,
      "text": "I’m turning the page and starting again"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 89.44,
      "endSec": 93.03,
      "text": "Я разрываю этот замкнутый круг"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 93.03,
      "endSec": 96.3,
      "text": "I’m breaking out of this endless loop"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 96.3,
      "endSec": 99.41,
      "text": "Мне больше не нужны чужие правила"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 99.41,
      "endSec": 104.04,
      "text": "I don’t need to live by someone else’s rules"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 104.04,
      "endSec": 106.91,
      "text": "Я не сотру ошибки — это мой урок"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 106.91,
      "endSec": 110.5,
      "text": "I won’t erase my mistakes; they’re mine to own"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 110.5,
      "endSec": 114.09,
      "text": "Я сам решаю, кем мне стать"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 114.09,
      "endSec": 119.28,
      "text": "I’ll make the choice of who I’ll become"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 119.28,
      "endSec": 129.28,
      "text": "Мои слова важны, но важнее мой поступок"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 137.95,
      "endSec": 141.46,
      "text": "My words mean something, but my actions mean more"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 141.46,
      "endSec": 144.73,
      "text": "Я не ищу лёгких ответов на вопросы"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 144.73,
      "endSec": 148.4,
      "text": "I won’t settle for easy answers anymore"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 148.4,
      "endSec": 151.59,
      "text": "Не каждый поворот ведёт туда, куда хотел"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 151.59,
      "endSec": 155.34,
      "text": "Not every turn will take me where I planned"
    },
    {
      "index": 34,
      "line": 18,
      "lang": "ru",
      "startSec": 155.34,
      "endSec": 158.54,
      "text": "Но я могу менять свой курс, пока иду"
    },
    {
      "index": 35,
      "line": 18,
      "lang": "en",
      "startSec": 158.54,
      "endSec": 162.61,
      "text": "But I can change direction as I go"
    },
    {
      "index": 36,
      "line": 19,
      "lang": "ru",
      "startSec": 162.61,
      "endSec": 166.12,
      "text": "Я разрываю этот замкнутый круг"
    },
    {
      "index": 37,
      "line": 19,
      "lang": "en",
      "startSec": 166.12,
      "endSec": 168.91,
      "text": "I’m breaking out of this endless loop"
    },
    {
      "index": 38,
      "line": 20,
      "lang": "ru",
      "startSec": 168.91,
      "endSec": 172.5,
      "text": "Мне больше не нужны чужие правила"
    },
    {
      "index": 39,
      "line": 20,
      "lang": "en",
      "startSec": 172.5,
      "endSec": 177.13,
      "text": "I don’t need to live by someone else’s rules"
    },
    {
      "index": 40,
      "line": 21,
      "lang": "ru",
      "startSec": 177.13,
      "endSec": 180.0,
      "text": "Я не сотру ошибки — это мой урок"
    },
    {
      "index": 41,
      "line": 21,
      "lang": "en",
      "startSec": 180.0,
      "endSec": 183.51,
      "text": "I won’t erase my mistakes; they’re mine to own"
    },
    {
      "index": 42,
      "line": 22,
      "lang": "ru",
      "startSec": 183.51,
      "endSec": 187.18,
      "text": "Я сам решаю, кем мне стать"
    },
    {
      "index": 43,
      "line": 22,
      "lang": "en",
      "startSec": 187.18,
      "endSec": 193.09,
      "text": "I’ll make the choice of who I’ll become"
    },
    {
      "index": 44,
      "line": 23,
      "lang": "ru",
      "startSec": 193.09,
      "endSec": 196.68,
      "text": "Я больше не боюсь начать с нуля"
    },
    {
      "index": 45,
      "line": 23,
      "lang": "en",
      "startSec": 196.68,
      "endSec": 200.34,
      "text": "I’m not afraid to start from scratch"
    },
    {
      "index": 46,
      "line": 24,
      "lang": "ru",
      "startSec": 200.34,
      "endSec": 203.85,
      "text": "Моя история — в моих руках"
    },
    {
      "index": 47,
      "line": 24,
      "lang": "en",
      "startSec": 203.85,
      "endSec": 215.16,
      "text": "My story is mine to write"
    }
  ],
