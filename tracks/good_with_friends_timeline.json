{
  "track": "good_with_friends",
  "durationSec": 185.96,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 10.21,
      "endSec": 11.89,
      "text": "Я вижу друзей у метро"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 11.89,
      "endSec": 13.96,
      "text": "I see my friends by the subway"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 13.96,
      "endSec": 15.64,
      "text": "Они уже ждут меня"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 15.64,
      "endSec": 17.31,
      "text": "They are already waiting for me"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 17.31,
      "endSec": 19.39,
      "text": "Мы здороваемся и смеёмся"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 19.39,
      "endSec": 21.22,
      "text": "We say hello and laugh"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 21.22,
      "endSec": 22.82,
      "text": "Кто-то снова опоздал"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 22.82,
      "endSec": 24.1,
      "text": "Someone is late again"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 24.1,
      "endSec": 25.85,
      "text": "Мы спрашиваем: «Как дела?»"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 25.85,
      "endSec": 27.21,
      "text": "We ask, “How are you?”"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 27.21,
      "endSec": 29.6,
      "text": "И говорим о разных вещах"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 29.6,
      "endSec": 32.07,
      "text": "And we talk about different things"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 32.07,
      "endSec": 33.99,
      "text": "О работе, фильмах и музыке"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 33.99,
      "endSec": 35.98,
      "text": "About work, movies and music"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 35.98,
      "endSec": 37.98,
      "text": "И о том, что было вчера"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 37.98,
      "endSec": 42.77,
      "text": "And about what happened yesterday"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 42.77,
      "endSec": 45.72,
      "text": "С друзьями всегда хорошо"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 45.72,
      "endSec": 48.11,
      "text": "It’s always good with friends"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 48.11,
      "endSec": 50.82,
      "text": "Мы смеёмся и говорим"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 50.82,
      "endSec": 53.54,
      "text": "We laugh and we talk"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 53.54,
      "endSec": 55.45,
      "text": "Нам не нужен большой план"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 55.45,
      "endSec": 57.13,
      "text": "We don’t need a big plan"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 57.13,
      "endSec": 59.04,
      "text": "Нам просто хорошо вместе"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 59.04,
      "endSec": 64.79,
      "text": "We just have a good time together"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 64.79,
      "endSec": 66.38,
      "text": "Мы идём по центру города"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 66.38,
      "endSec": 68.3,
      "text": "We walk through the city center"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 68.3,
      "endSec": 69.81,
      "text": "Смотрим на людей и дома"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 69.81,
      "endSec": 71.49,
      "text": "We look at people and buildings"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 71.49,
      "endSec": 73.4,
      "text": "Мой друг рассказывает шутку"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 73.4,
      "endSec": 75.24,
      "text": "My friend tells a joke"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 75.24,
      "endSec": 76.75,
      "text": "И мы смеёмся всю дорогу"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 76.75,
      "endSec": 78.75,
      "text": "And we laugh all the way"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 78.75,
      "endSec": 80.27,
      "text": "Мы заходим выпить кофе"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 80.27,
      "endSec": 81.62,
      "text": "We stop to have some coffee"
    },
    {
      "index": 34,
      "line": 18,
      "lang": "ru",
      "startSec": 81.62,
      "endSec": 83.54,
      "text": "И снова начинаем говорить"
    },
    {
      "index": 35,
      "line": 18,
      "lang": "en",
      "startSec": 83.54,
      "endSec": 86.25,
      "text": "And start talking again"
    },
    {
      "index": 36,
      "line": 19,
      "lang": "ru",
      "startSec": 86.25,
      "endSec": 88.25,
      "text": "Кто-то хочет посмотреть фильм"
    },
    {
      "index": 37,
      "line": 19,
      "lang": "en",
      "startSec": 88.25,
      "endSec": 89.76,
      "text": "Someone wants to watch a movie"
    },
    {
      "index": 38,
      "line": 20,
      "lang": "ru",
      "startSec": 89.76,
      "endSec": 91.83,
      "text": "А кто-то хочет пойти на концерт"
    },
    {
      "index": 39,
      "line": 20,
      "lang": "en",
      "startSec": 91.83,
      "endSec": 97.18,
      "text": "And someone wants to go to a concert"
    },
    {
      "index": 40,
      "line": 21,
      "lang": "ru",
      "startSec": 97.18,
      "endSec": 100.13,
      "text": "С друзьями всегда хорошо"
    },
    {
      "index": 41,
      "line": 21,
      "lang": "en",
      "startSec": 100.13,
      "endSec": 102.53,
      "text": "It’s always good with friends"
    },
    {
      "index": 42,
      "line": 22,
      "lang": "ru",
      "startSec": 102.53,
      "endSec": 105.24,
      "text": "Мы смеёмся и говорим"
    },
    {
      "index": 43,
      "line": 22,
      "lang": "en",
      "startSec": 105.24,
      "endSec": 107.95,
      "text": "We laugh and we talk"
    },
    {
      "index": 44,
      "line": 23,
      "lang": "ru",
      "startSec": 107.95,
      "endSec": 109.87,
      "text": "Нам не нужен большой план"
    },
    {
      "index": 45,
      "line": 23,
      "lang": "en",
      "startSec": 109.87,
      "endSec": 111.54,
      "text": "We don’t need a big plan"
    },
    {
      "index": 46,
      "line": 24,
      "lang": "ru",
      "startSec": 111.54,
      "endSec": 113.46,
      "text": "Нам просто хорошо вместе"
    },
    {
      "index": 47,
      "line": 24,
      "lang": "en",
      "startSec": 113.46,
      "endSec": 119.2,
      "text": "We just have a good time together"
    },
    {
      "index": 48,
      "line": 25,
      "lang": "ru",
      "startSec": 119.2,
      "endSec": 120.88,
      "text": "Мы решаем встретиться завтра"
    },
    {
      "index": 49,
      "line": 25,
      "lang": "en",
      "startSec": 120.88,
      "endSec": 122.55,
      "text": "We decide to meet tomorrow"
    },
    {
      "index": 50,
      "line": 26,
      "lang": "ru",
      "startSec": 122.55,
      "endSec": 124.31,
      "text": "Может, пойдём в новый парк"
    },
    {
      "index": 51,
      "line": 26,
      "lang": "en",
      "startSec": 124.31,
      "endSec": 127.58,
      "text": "Maybe we’ll go to a new park"
    },
    {
      "index": 52,
      "line": 27,
      "lang": "ru",
      "startSec": 127.58,
      "endSec": 129.57,
      "text": "Или найдём хорошее кафе"
    },
    {
      "index": 53,
      "line": 27,
      "lang": "en",
      "startSec": 129.57,
      "endSec": 131.17,
      "text": "Or find a good cafe"
    },
    {
      "index": 54,
      "line": 28,
      "lang": "ru",
      "startSec": 131.17,
      "endSec": 133.32,
      "text": "И попробуем новую еду"
    },
    {
      "index": 55,
      "line": 28,
      "lang": "en",
      "startSec": 133.32,
      "endSec": 135.0,
      "text": "And try some new food"
    },
    {
      "index": 56,
      "line": 29,
      "lang": "ru",
      "startSec": 135.0,
      "endSec": 136.91,
      "text": "Время проходит слишком быстро"
    },
    {
      "index": 57,
      "line": 29,
      "lang": "en",
      "startSec": 136.91,
      "endSec": 138.91,
      "text": "Time goes by too fast"
    },
    {
      "index": 58,
      "line": 30,
      "lang": "ru",
      "startSec": 138.91,
      "endSec": 140.27,
      "text": "Уже становится темно"
    },
    {
      "index": 59,
      "line": 30,
      "lang": "en",
      "startSec": 140.27,
      "endSec": 141.78,
      "text": "It’s already getting dark"
    },
    {
      "index": 60,
      "line": 31,
      "lang": "ru",
      "startSec": 141.78,
      "endSec": 144.02,
      "text": "Мы говорим: «Увидимся завтра»"
    },
    {
      "index": 61,
      "line": 31,
      "lang": "en",
      "startSec": 144.02,
      "endSec": 146.41,
      "text": "We say, “See you tomorrow”"
    },
    {
      "index": 62,
      "line": 32,
      "lang": "ru",
      "startSec": 146.41,
      "endSec": 148.72,
      "text": "И идём каждый своей дорогой"
    },
    {
      "index": 63,
      "line": 32,
      "lang": "en",
      "startSec": 148.72,
      "endSec": 151.91,
      "text": "And we each go our own way"
    },
    {
      "index": 64,
      "line": 33,
      "lang": "ru",
      "startSec": 151.91,
      "endSec": 154.87,
      "text": "Хороший вечер, хорошие друзья"
    },
    {
      "index": 65,
      "line": 33,
      "lang": "en",
      "startSec": 154.87,
      "endSec": 156.78,
      "text": "A good evening, good friends"
    },
    {
      "index": 66,
      "line": 34,
      "lang": "ru",
      "startSec": 156.78,
      "endSec": 158.86,
      "text": "Нам было весело сегодня"
    },
    {
      "index": 67,
      "line": 34,
      "lang": "en",
      "startSec": 158.86,
      "endSec": 162.21,
      "text": "We had fun today"
    },
    {
      "index": 68,
      "line": 35,
      "lang": "ru",
      "startSec": 162.21,
      "endSec": 163.72,
      "text": "Мы ещё встретимся скоро"
    },
    {
      "index": 69,
      "line": 35,
      "lang": "en",
      "startSec": 163.72,
      "endSec": 165.56,
      "text": "We’ll meet again soon"
    },
    {
      "index": 70,
      "line": 36,
      "lang": "ru",
      "startSec": 165.56,
      "endSec": 167.15,
      "text": "И снова будем смеяться"
    },
    {
      "index": 71,
      "line": 36,
      "lang": "en",
      "startSec": 167.15,
      "endSec": 185.96,
      "text": "And we’ll laugh again"
    }
  ],
