{
  "track": "good_with_friends",
  "durationSec": 81.88,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 10.13,
      "endSec": 11.89,
      "text": "Я вижу друзей у метро"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 11.89,
      "endSec": 14.04,
      "text": "I see my friends by the subway"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 14.04,
      "endSec": 15.96,
      "text": "Мы здороваемся и смеёмся"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 15.96,
      "endSec": 17.47,
      "text": "We say hello and laugh"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 17.47,
      "endSec": 19.23,
      "text": "Кто-то снова опаздывает"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 19.23,
      "endSec": 20.82,
      "text": "Someone is late again"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 20.82,
      "endSec": 23.78,
      "text": "С друзьями всегда хорошо"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 23.78,
      "endSec": 26.25,
      "text": "It's always good with friends"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 26.25,
      "endSec": 28.96,
      "text": "Мы смеёмся и говорим"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 28.96,
      "endSec": 31.6,
      "text": "We laugh and we talk"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 31.6,
      "endSec": 33.03,
      "text": "Нам не важно, где мы"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 33.03,
      "endSec": 35.19,
      "text": "We don't care where we are"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 35.19,
      "endSec": 37.1,
      "text": "Нам просто хорошо вместе"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 37.1,
      "endSec": 42.77,
      "text": "We just feel good together"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 42.77,
      "endSec": 44.36,
      "text": "Мы идём по центру города"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 44.36,
      "endSec": 46.04,
      "text": "We walk through the city center"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 46.04,
      "endSec": 47.71,
      "text": "Мой друг рассказывает шутку"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 47.71,
      "endSec": 49.23,
      "text": "My friend tells a joke"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 49.23,
      "endSec": 51.22,
      "text": "Мы заходим выпить кофе"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 51.22,
      "endSec": 53.38,
      "text": "We stop to have some coffee"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 53.38,
      "endSec": 56.25,
      "text": "С друзьями всегда хорошо"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 56.25,
      "endSec": 58.56,
      "text": "It's always good with friends"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 58.56,
      "endSec": 60.56,
      "text": "Нам было весело сегодня"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 60.56,
      "endSec": 62.63,
      "text": "We had fun today"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 62.63,
      "endSec": 64.87,
      "text": "Мы говорим: «Увидимся завтра»"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 64.87,
      "endSec": 81.88,
      "text": "We say, \"See you tomorrow\""
    }
  ],
