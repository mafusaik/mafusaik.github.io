{
  "track": "closer_than_ever",
  "durationSec": 87.04,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 0.48,
      "endSec": 2.87,
      "text": "Мы можем быть далеко"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 2.87,
      "endSec": 4.87,
      "text": "We can be miles apart"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 4.87,
      "endSec": 7.26,
      "text": "Но всё равно на связи"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 7.26,
      "endSec": 9.41,
      "text": "But we're still within reach"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 9.41,
      "endSec": 10.77,
      "text": "Мы видим друг друга"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 10.77,
      "endSec": 11.97,
      "text": "We can see each other"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 11.97,
      "endSec": 13.09,
      "text": "И не теряем связь"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 13.09,
      "endSec": 19.87,
      "text": "And we don't lose touch"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 19.87,
      "endSec": 22.1,
      "text": "Мы ближе, чем когда-либо"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 22.1,
      "endSec": 23.94,
      "text": "We're closer than ever"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 23.94,
      "endSec": 25.53,
      "text": "Но иногда дальше друг от друга"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 25.53,
      "endSec": 28.32,
      "text": "But at times we're more distant from each other"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 28.32,
      "endSec": 30.64,
      "text": "Технологии держат нас рядом"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 30.64,
      "endSec": 32.71,
      "text": "Technology keeps us close"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 32.71,
      "endSec": 34.55,
      "text": "Но не всегда соединяют сердца"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 34.55,
      "endSec": 37.42,
      "text": "But it doesn't always bring hearts together"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 37.42,
      "endSec": 39.26,
      "text": "Мы отправляем фотографии"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 39.26,
      "endSec": 41.73,
      "text": "We send photos"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 41.73,
      "endSec": 43.56,
      "text": "Мы ставим друг другу сердечки"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 43.56,
      "endSec": 46.28,
      "text": "We leave each other little hearts"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 46.28,
      "endSec": 48.51,
      "text": "Но экран не передаёт интонацию"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 48.51,
      "endSec": 50.51,
      "text": "But a screen can't convey tone"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 50.51,
      "endSec": 52.5,
      "text": "Одно короткое сообщение"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 52.5,
      "endSec": 54.41,
      "text": "A single short message"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 54.41,
      "endSec": 56.01,
      "text": "Можно понять по-разному"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 56.01,
      "endSec": 58.4,
      "text": "Can be read in different ways"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 58.4,
      "endSec": 60.56,
      "text": "Нам не хватает настоящих слов"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 60.56,
      "endSec": 64.71,
      "text": "We run short of real words"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 64.71,
      "endSec": 66.62,
      "text": "Мы можем быть рядом онлайн"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 66.62,
      "endSec": 68.7,
      "text": "We can be close online"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 68.7,
      "endSec": 70.93,
      "text": "И всё равно чувствовать дистанцию"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 70.93,
      "endSec": 73.08,
      "text": "And still feel the distance"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 73.08,
      "endSec": 75.08,
      "text": "Может быть, связь — это больше"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 75.08,
      "endSec": 77.55,
      "text": "Maybe a connection means more"
    },
    {
      "index": 34,
      "line": 18,
      "lang": "ru",
      "startSec": 77.55,
      "endSec": 79.79,
      "text": "Чем просто быть онлайн"
    },
    {
      "index": 35,
      "line": 18,
      "lang": "en",
      "startSec": 79.79,
      "endSec": 87.04,
      "text": "Than just being online"
    }
  ],
