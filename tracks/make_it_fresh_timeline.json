{
  "track": "make_it_fresh",
  "durationSec": 150.8,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 12.93,
      "endSec": 14.68,
      "text": "Достань помидоры"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 14.68,
      "endSec": 16.04,
      "text": "Get the tomatoes"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 16.04,
      "endSec": 17.47,
      "text": "Пусть будут сочными"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 17.47,
      "endSec": 18.75,
      "text": "Keep them juicy"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 18.75,
      "endSec": 19.95,
      "text": "Огурцы нарежем"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 19.95,
      "endSec": 21.46,
      "text": "Let’s chop the cucumbers"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 21.46,
      "endSec": 23.14,
      "text": "Кусочками крупными"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 23.14,
      "endSec": 24.34,
      "text": "Into big chunks"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 24.34,
      "endSec": 25.61,
      "text": "Красный лук добавим"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 25.61,
      "endSec": 27.13,
      "text": "Let’s add red onion"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 27.13,
      "endSec": 28.56,
      "text": "Только чуть-чуть"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 28.56,
      "endSec": 29.76,
      "text": "Just a little"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 29.76,
      "endSec": 31.84,
      "text": "Свёклу сегодня не кладём"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 31.84,
      "endSec": 33.27,
      "text": "No beetroot today"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 33.27,
      "endSec": 34.55,
      "text": "Оставим на потом"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 34.55,
      "endSec": 36.38,
      "text": "Let’s save it for later"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 36.38,
      "endSec": 37.9,
      "text": "Зелёный перец берём"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 37.9,
      "endSec": 39.49,
      "text": "Let’s get green pepper"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 39.49,
      "endSec": 40.85,
      "text": "Он сладкий и свежий"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 40.85,
      "endSec": 42.29,
      "text": "It’s sweet and fresh"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 42.29,
      "endSec": 44.28,
      "text": "Петрушки добавим горсть"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 44.28,
      "endSec": 46.91,
      "text": "Let’s add a handful of parsley"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 46.91,
      "endSec": 48.75,
      "text": "А кукуруза из банки?"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 48.75,
      "endSec": 50.59,
      "text": "What about canned sweetcorn?"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 50.59,
      "endSec": 51.94,
      "text": "Да, добавим немного"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 51.94,
      "endSec": 53.38,
      "text": "Yes, just a little"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 53.38,
      "endSec": 55.45,
      "text": "Авокадо тоже берём"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 55.45,
      "endSec": 58.24,
      "text": "Let’s add avocado too"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 58.24,
      "endSec": 60.8,
      "text": "Картошку сегодня не будем"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 60.8,
      "endSec": 63.51,
      "text": "No potatoes today"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 63.51,
      "endSec": 65.35,
      "text": "Фету раскрошим"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 65.35,
      "endSec": 66.94,
      "text": "Let’s crumble the feta"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 66.94,
      "endSec": 68.86,
      "text": "Оливок добавим немного"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 68.86,
      "endSec": 78.86,
      "text": "Let’s add a few olives"
    },
    {
      "index": 34,
      "line": 18,
      "lang": "ru",
      "startSec": 80.19,
      "endSec": 81.78,
      "text": "Лимон для заправки"
    },
    {
      "index": 35,
      "line": 18,
      "lang": "en",
      "startSec": 81.78,
      "endSec": 83.06,
      "text": "Lemon for the dressing"
    },
    {
      "index": 36,
      "line": 19,
      "lang": "ru",
      "startSec": 83.06,
      "endSec": 84.65,
      "text": "Оливковое масло"
    },
    {
      "index": 37,
      "line": 19,
      "lang": "en",
      "startSec": 84.65,
      "endSec": 85.85,
      "text": "Olive oil"
    },
    {
      "index": 38,
      "line": 20,
      "lang": "ru",
      "startSec": 85.85,
      "endSec": 87.93,
      "text": "Немного горчицы добавим"
    },
    {
      "index": 39,
      "line": 20,
      "lang": "en",
      "startSec": 87.93,
      "endSec": 89.44,
      "text": "Let’s add a little mustard"
    },
    {
      "index": 40,
      "line": 21,
      "lang": "ru",
      "startSec": 89.44,
      "endSec": 91.2,
      "text": "Теперь всё перемешаем"
    },
    {
      "index": 41,
      "line": 21,
      "lang": "en",
      "startSec": 91.2,
      "endSec": 92.47,
      "text": "Now let’s mix it up"
    },
    {
      "index": 42,
      "line": 22,
      "lang": "ru",
      "startSec": 92.47,
      "endSec": 93.75,
      "text": "Соль и чёрный перец"
    },
    {
      "index": 43,
      "line": 22,
      "lang": "en",
      "startSec": 93.75,
      "endSec": 95.11,
      "text": "Salt and black pepper"
    },
    {
      "index": 44,
      "line": 23,
      "lang": "ru",
      "startSec": 95.11,
      "endSec": 96.78,
      "text": "Совсем чуть-чуть"
    },
    {
      "index": 45,
      "line": 23,
      "lang": "en",
      "startSec": 96.78,
      "endSec": 97.9,
      "text": "Just a little"
    },
    {
      "index": 46,
      "line": 24,
      "lang": "ru",
      "startSec": 97.9,
      "endSec": 99.5,
      "text": "Попробуй наш салат"
    },
    {
      "index": 47,
      "line": 24,
      "lang": "en",
      "startSec": 99.5,
      "endSec": 100.93,
      "text": "Taste our salad"
    },
    {
      "index": 48,
      "line": 25,
      "lang": "ru",
      "startSec": 100.93,
      "endSec": 101.97,
      "text": "Он уже готов"
    },
    {
      "index": 49,
      "line": 25,
      "lang": "en",
      "startSec": 101.97,
      "endSec": 111.97,
      "text": "It’s ready to eat"
    },
    {
      "index": 50,
      "line": 26,
      "lang": "ru",
      "startSec": 114.97,
      "endSec": 117.77,
      "text": "Режь и смешивай"
    },
    {
      "index": 51,
      "line": 26,
      "lang": "en",
      "startSec": 117.77,
      "endSec": 119.92,
      "text": "Chop and mix"
    },
    {
      "index": 52,
      "line": 27,
      "lang": "ru",
      "startSec": 119.92,
      "endSec": 122.79,
      "text": "Пробуй — будь смелей"
    },
    {
      "index": 53,
      "line": 27,
      "lang": "en",
      "startSec": 122.79,
      "endSec": 125.58,
      "text": "Taste it — be bold"
    },
    {
      "index": 54,
      "line": 28,
      "lang": "ru",
      "startSec": 125.58,
      "endSec": 127.82,
      "text": "Выбирай, что любишь"
    },
    {
      "index": 55,
      "line": 28,
      "lang": "en",
      "startSec": 127.82,
      "endSec": 131.01,
      "text": "Choose what you love"
    },
    {
      "index": 56,
      "line": 29,
      "lang": "ru",
      "startSec": 131.01,
      "endSec": 133.32,
      "text": "Готовь по-своему"
    },
    {
      "index": 57,
      "line": 29,
      "lang": "en",
      "startSec": 133.32,
      "endSec": 150.8,
      "text": "Make it your own"
    }
  ],
