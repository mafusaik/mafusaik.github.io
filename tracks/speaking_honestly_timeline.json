{
  "track": "speaking_honestly",
  "durationSec": 104.76,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 2.79,
      "endSec": 5.03,
      "text": "Мы долго избегали этой темы"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 5.03,
      "endSec": 7.5,
      "text": "We had avoided this topic for so long"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 7.5,
      "endSec": 9.89,
      "text": "Ты говорила, что всё нормально"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 9.89,
      "endSec": 11.89,
      "text": "You said that everything was fine"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 11.89,
      "endSec": 14.12,
      "text": "А я делал вид, что верю"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 14.12,
      "endSec": 16.68,
      "text": "And I pretended that I believed you"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 16.68,
      "endSec": 19.15,
      "text": "Мы знали, что что-то изменилось"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 19.15,
      "endSec": 21.54,
      "text": "We knew that something had changed"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 21.54,
      "endSec": 23.94,
      "text": "Наконец мы решили говорить честно"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 23.94,
      "endSec": 26.97,
      "text": "Finally, we decided to speak honestly"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 26.97,
      "endSec": 28.96,
      "text": "Даже если будет трудно"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 28.96,
      "endSec": 31.2,
      "text": "Even if it was going to be difficult"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 31.2,
      "endSec": 33.43,
      "text": "Я сказал, что мне было одиноко"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 33.43,
      "endSec": 35.98,
      "text": "I said that I had felt lonely"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 35.98,
      "endSec": 38.38,
      "text": "Ты призналась, что чувствовала то же"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 38.38,
      "endSec": 41.41,
      "text": "You admitted that you had felt the same"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 41.41,
      "endSec": 43.72,
      "text": "Ты сказала, что чувствовала давление"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 43.72,
      "endSec": 46.2,
      "text": "You said that you had felt under pressure"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 46.2,
      "endSec": 48.51,
      "text": "Я объяснил, что мне было страшно"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 48.51,
      "endSec": 50.66,
      "text": "I explained that I had been scared"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 50.66,
      "endSec": 52.26,
      "text": "Я понял, что слушать"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 52.26,
      "endSec": 54.49,
      "text": "I realized that listening"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 54.49,
      "endSec": 56.81,
      "text": "Иногда важнее, чем отвечать"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 56.81,
      "endSec": 60.96,
      "text": "Was sometimes more important than answering"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 60.96,
      "endSec": 63.35,
      "text": "Теперь мы можем говорить открыто"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 63.35,
      "endSec": 65.82,
      "text": "Now we can speak openly"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 65.82,
      "endSec": 67.98,
      "text": "Мы больше не прячемся за молчанием"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 67.98,
      "endSec": 70.53,
      "text": "We no longer hide behind silence"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 70.53,
      "endSec": 72.69,
      "text": "Я не знаю, что будет дальше"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 72.69,
      "endSec": 74.92,
      "text": "I don't know what will happen next"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 74.92,
      "endSec": 77.31,
      "text": "Но теперь мы говорим честно"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 77.31,
      "endSec": 79.79,
      "text": "But now we're speaking honestly"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 79.79,
      "endSec": 82.1,
      "text": "И, может быть, этого достаточно"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 82.1,
      "endSec": 104.76,
      "text": "And maybe that's enough"
    }
  ],
