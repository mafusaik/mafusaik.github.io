{
  "track": "morning_routine",
  "durationSec": 150.0,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 9.63,
      "endSec": 14.17,
      "text": "Я просыпаюсь рано утром"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 14.17,
      "endSec": 17.73,
      "text": "I wake up early in the morning"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 17.73,
      "endSec": 21.63,
      "text": "Я открываю глаза и встаю с кровати"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 21.63,
      "endSec": 26.73,
      "text": "I open my eyes and get out of bed"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 26.73,
      "endSec": 30.77,
      "text": "Я умываюсь и чищу зубы"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 30.77,
      "endSec": 35.83,
      "text": "I wash my face and brush my teeth"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 35.83,
      "endSec": 40.53,
      "text": "Я надеваю одежду и расчёсываю волосы"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 40.53,
      "endSec": 45.33,
      "text": "I get dressed and brush my hair"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 45.33,
      "endSec": 47.43,
      "text": "Я иду на кухню и готовлю завтрак"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 47.43,
      "endSec": 49.93,
      "text": "I go to the kitchen and make breakfast"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 49.93,
      "endSec": 52.03,
      "text": "Я ем яйца, хлеб и немного фруктов"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 52.03,
      "endSec": 54.17,
      "text": "I eat eggs, bread, and some fruit"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 54.17,
      "endSec": 57.03,
      "text": "Я пью горячий кофе"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 57.03,
      "endSec": 59.57,
      "text": "I drink hot coffee"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 59.57,
      "endSec": 61.83,
      "text": "Кофе помогает мне проснуться"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 61.83,
      "endSec": 63.63,
      "text": "Coffee helps me wake up"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 63.63,
      "endSec": 65.9,
      "text": "Я смотрю на часы"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 65.9,
      "endSec": 68.07,
      "text": "I look at the clock"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 68.07,
      "endSec": 70.2,
      "text": "Мне пора идти"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 70.2,
      "endSec": 72.73,
      "text": "It is time to go"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 72.73,
      "endSec": 74.83,
      "text": "Я беру сумку и выхожу из дома"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 74.83,
      "endSec": 81.57,
      "text": "I take my bag and leave the house"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 81.57,
      "endSec": 84.93,
      "text": "Я иду на работу или учёбу"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 84.93,
      "endSec": 86.67,
      "text": "I go to work or school"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 86.67,
      "endSec": 88.93,
      "text": "Я слушаю музыку по дороге"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 88.93,
      "endSec": 91.3,
      "text": "I listen to music on the way"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 91.3,
      "endSec": 93.47,
      "text": "Я думаю о моём дне"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 93.47,
      "endSec": 95.17,
      "text": "I think about my day"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 95.17,
      "endSec": 97.53,
      "text": "Сегодня у меня много дел"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 97.53,
      "endSec": 100.93,
      "text": "I have many things to do today"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 100.93,
      "endSec": 102.83,
      "text": "Сначала я буду работать"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 102.83,
      "endSec": 104.37,
      "text": "First, I will work"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 104.37,
      "endSec": 107.07,
      "text": "Потом я сделаю небольшой перерыв"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 107.07,
      "endSec": 109.6,
      "text": "Then I will take a short break"
    },
    {
      "index": 34,
      "line": 18,
      "lang": "ru",
      "startSec": 109.6,
      "endSec": 111.7,
      "text": "После работы я пойду домой"
    },
    {
      "index": 35,
      "line": 18,
      "lang": "en",
      "startSec": 111.7,
      "endSec": 118.17,
      "text": "After work, I will go home"
    },
    {
      "index": 36,
      "line": 19,
      "lang": "ru",
      "startSec": 118.17,
      "endSec": 121.87,
      "text": "Я хочу хорошо провести этот день"
    },
    {
      "index": 37,
      "line": 19,
      "lang": "en",
      "startSec": 121.87,
      "endSec": 123.23,
      "text": "I want to have a good day"
    },
    {
      "index": 38,
      "line": 20,
      "lang": "ru",
      "startSec": 123.23,
      "endSec": 124.63,
      "text": "Я готов начать"
    },
    {
      "index": 39,
      "line": 20,
      "lang": "en",
      "startSec": 124.63,
      "endSec": 127.43,
      "text": "I am ready to start"
    },
    {
      "index": 40,
      "line": 21,
      "lang": "ru",
      "startSec": 127.43,
      "endSec": 133.23,
      "text": "Это моё простое утро"
    },
    {
      "index": 41,
      "line": 21,
      "lang": "en",
      "startSec": 133.23,
      "endSec": 150.0,
      "text": "This is my simple morning"
    }
  ],
