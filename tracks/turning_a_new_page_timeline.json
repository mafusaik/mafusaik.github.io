{
  "track": "turning_a_new_page",
  "durationSec": 82.76,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 10.77,
      "endSec": 13.4,
      "text": "Я долго думал о переменах"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 13.4,
      "endSec": 15.88,
      "text": "I thought about change for so long"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 15.88,
      "endSec": 18.35,
      "text": "Но не решался начать"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 18.35,
      "endSec": 20.9,
      "text": "But I couldn't bring myself to start"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 20.9,
      "endSec": 23.14,
      "text": "Мы держимся за прошлое"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 23.14,
      "endSec": 25.69,
      "text": "We hold on to the past"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 25.69,
      "endSec": 28.25,
      "text": "Мы боимся неизвестности"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 28.25,
      "endSec": 31.04,
      "text": "We're afraid of the unknown"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 31.04,
      "endSec": 32.47,
      "text": "Я не знаю, что дальше"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 32.47,
      "endSec": 33.59,
      "text": "I don't know what's ahead"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 33.59,
      "endSec": 35.03,
      "text": "Я могу ошибиться"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 35.03,
      "endSec": 36.14,
      "text": "I might make a mistake"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 36.14,
      "endSec": 38.78,
      "text": "Я открываю новую страницу"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 38.78,
      "endSec": 40.61,
      "text": "I'm turning a new page"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 40.61,
      "endSec": 43.16,
      "text": "И оставляю сомнения"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 43.16,
      "endSec": 45.64,
      "text": "And leaving my doubts behind"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 45.64,
      "endSec": 47.55,
      "text": "Мне не нужны все ответы"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 47.55,
      "endSec": 50.82,
      "text": "I don't need all the answers"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 50.82,
      "endSec": 53.46,
      "text": "Не каждый поворот верный"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 53.46,
      "endSec": 56.01,
      "text": "Not every turn is the right one"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 56.01,
      "endSec": 57.93,
      "text": "Но каждый меня учит"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 57.93,
      "endSec": 61.6,
      "text": "But every one teaches me"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 61.6,
      "endSec": 63.67,
      "text": "Я не знаю, куда приду"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 63.67,
      "endSec": 66.14,
      "text": "I don't know where I'll end up"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 66.14,
      "endSec": 68.54,
      "text": "Но мне интересно узнать"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 68.54,
      "endSec": 71.17,
      "text": "But I'm curious to find out"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 71.17,
      "endSec": 73.96,
      "text": "Иногда нужно потеряться"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 73.96,
      "endSec": 76.92,
      "text": "Sometimes you have to get lost"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 76.92,
      "endSec": 78.83,
      "text": "Чтобы найти свой путь"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 78.83,
      "endSec": 82.76,
      "text": "To find your way"
    }
  ],
