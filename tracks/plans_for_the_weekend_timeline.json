{
  "track": "plans_for_the_weekend",
  "durationSec": 69.6,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 1.12,
      "endSec": 4.39,
      "text": "В субботу я встречусь с друзьями"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 4.39,
      "endSec": 8.14,
      "text": "On Saturday, I’m going to meet my friends"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 8.14,
      "endSec": 9.26,
      "text": "Мы пойдём на пляж"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 9.26,
      "endSec": 10.45,
      "text": "We’re going to the beach"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 10.45,
      "endSec": 13.09,
      "text": "Мы хорошо проведём время"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 13.09,
      "endSec": 17.71,
      "text": "We’ll have a good time"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 17.71,
      "endSec": 19.79,
      "text": "Это мои планы на выходные"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 19.79,
      "endSec": 21.62,
      "text": "These are my weekend plans"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 21.62,
      "endSec": 23.86,
      "text": "Я хочу отдыхать и веселиться"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 23.86,
      "endSec": 26.09,
      "text": "I want to relax and have fun"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 26.09,
      "endSec": 28.25,
      "text": "Я буду делать то, что люблю"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 28.25,
      "endSec": 34.15,
      "text": "I’m going to do what I love"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 34.15,
      "endSec": 37.18,
      "text": "В воскресенье я пойду за покупками"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 37.18,
      "endSec": 39.02,
      "text": "On Sunday, I’m going shopping"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 39.02,
      "endSec": 41.01,
      "text": "Я куплю новую футболку"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 41.01,
      "endSec": 43.09,
      "text": "I’ll buy a new T-shirt"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 43.09,
      "endSec": 44.44,
      "text": "Потом выпью кофе"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 44.44,
      "endSec": 45.48,
      "text": "Then I’ll have a coffee"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 45.48,
      "endSec": 47.79,
      "text": "Если будет дождь, я останусь дома"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 47.79,
      "endSec": 52.02,
      "text": "If it rains, I’ll stay at home"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 52.02,
      "endSec": 54.1,
      "text": "Это мои планы на выходные"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 54.1,
      "endSec": 56.01,
      "text": "These are my weekend plans"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 56.01,
      "endSec": 58.16,
      "text": "Я хочу отдыхать и веселиться"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 58.16,
      "endSec": 60.32,
      "text": "I want to relax and have fun"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 60.32,
      "endSec": 62.71,
      "text": "Я проведу отличные выходные"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 62.71,
      "endSec": 69.6,
      "text": "I’ll have a great weekend"
    }
  ],
