{
  "track": "plans_for_the_weekend",
  "durationSec": 174.36,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 0.67,
      "endSec": 2.97,
      "text": "В субботу я встречусь с друзьями"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 2.97,
      "endSec": 5.13,
      "text": "On Saturday, I am going to meet my friends"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 5.13,
      "endSec": 7.67,
      "text": "Мы собираемся пойти в кафе"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 7.67,
      "endSec": 9.67,
      "text": "We are going to go to a café"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 9.67,
      "endSec": 12.33,
      "text": "Я хочу поговорить и посмеяться"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 12.33,
      "endSec": 14.27,
      "text": "I want to talk and laugh"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 14.27,
      "endSec": 16.63,
      "text": "Мы хорошо проведём время вместе"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 16.63,
      "endSec": 18.93,
      "text": "We will have a good time together"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 18.93,
      "endSec": 21.13,
      "text": "Это мои планы на выходные"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 21.13,
      "endSec": 23.07,
      "text": "These are my weekend plans"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 23.07,
      "endSec": 25.47,
      "text": "Я хочу отдыхать и веселиться"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 25.47,
      "endSec": 27.47,
      "text": "I want to relax and have fun"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 27.47,
      "endSec": 29.77,
      "text": "Я собираюсь делать то, что люблю"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 29.77,
      "endSec": 32.03,
      "text": "I am going to do what I love"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 32.03,
      "endSec": 34.33,
      "text": "Я хочу наслаждаться каждым днём"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 34.33,
      "endSec": 37.57,
      "text": "I want to enjoy every day"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 37.57,
      "endSec": 41.27,
      "text": "В воскресенье я собираюсь пойти за покупками"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 41.27,
      "endSec": 45.93,
      "text": "On Sunday, I am going to go shopping"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 45.93,
      "endSec": 48.27,
      "text": "Мне нужно купить еду на неделю"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 48.27,
      "endSec": 50.13,
      "text": "I need to buy food for the week"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 50.13,
      "endSec": 52.23,
      "text": "Я хочу купить новую футболку"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 52.23,
      "endSec": 54.33,
      "text": "I want to buy a new T-shirt"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 54.33,
      "endSec": 56.57,
      "text": "Я хотел бы выпить кофе после покупок"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 56.57,
      "endSec": 59.1,
      "text": "I would like to have a coffee after shopping"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 59.1,
      "endSec": 61.23,
      "text": "Это мои планы на выходные"
    },
    {
      "index": 25,
