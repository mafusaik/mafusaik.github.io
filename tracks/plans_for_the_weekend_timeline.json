    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 74.23,
      "endSec": 94.17,
      "text": "I want to enjoy every day"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 94.17,
      "endSec": 96.67,
      "text": "Потом я собираюсь пойти на прогулку"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 96.67,
      "endSec": 99.03,
      "text": "Then I am going to go for a walk"
    },
    {
      "index": 34,
      "line": 18,
      "lang": "ru",
      "startSec": 99.03,
      "endSec": 101.07,
      "text": "Я хочу гулять в парке"
    },
    {
      "index": 35,
      "line": 18,
      "lang": "en",
      "startSec": 101.07,
      "endSec": 103.17,
      "text": "I want to walk in the park"
    },
    {
      "index": 36,
      "line": 19,
      "lang": "ru",
      "startSec": 103.17,
      "endSec": 105.13,
      "text": "Вечером я пойду в кино"
    },
    {
      "index": 37,
      "line": 19,
      "lang": "en",
      "startSec": 105.13,
      "endSec": 107.37,
      "text": "In the evening, I will go to the cinema"
    },
    {
      "index": 38,
      "line": 20,
      "lang": "ru",
      "startSec": 107.37,
      "endSec": 109.67,
      "text": "Я хотел бы посмотреть хороший фильм"
    },
    {
      "index": 39,
      "line": 20,
      "lang": "en",
      "startSec": 109.67,
      "endSec": 112.27,
      "text": "I would like to watch a good movie"
    },
    {
      "index": 40,
      "line": 21,
      "lang": "ru",
      "startSec": 112.27,
      "endSec": 115.8,
      "text": "Если погода будет плохой, я останусь дома"
    },
    {
      "index": 41,
      "line": 21,
      "lang": "en",
      "startSec": 115.8,
      "endSec": 120.67,
      "text": "If the weather is bad, I will stay at home"
    },
    {
      "index": 42,
      "line": 22,
      "lang": "ru",
      "startSec": 120.67,
      "endSec": 123.67,
      "text": "Я буду смотреть телевизор и отдыхать"
    },
    {
      "index": 43,
      "line": 22,
      "lang": "en",
      "startSec": 123.67,
      "endSec": 125.9,
      "text": "I will watch TV and relax"
    },
    {
      "index": 44,
      "line": 23,
      "lang": "ru",
      "startSec": 125.9,
      "endSec": 128.17,
      "text": "Я хочу приготовить вкусный ужин"
    },
    {
      "index": 45,
      "line": 23,
      "lang": "en",
      "startSec": 128.17,
      "endSec": 130.17,
      "text": "I want to cook a nice dinner"
    },
    {
      "index": 46,
      "line": 24,
      "lang": "ru",
      "startSec": 130.17,
      "endSec": 133.1,
      "text": "И просто наслаждаться тихим вечером"
    },
    {
      "index": 47,
      "line": 24,
      "lang": "en",
      "startSec": 133.1,
      "endSec": 136.73,
