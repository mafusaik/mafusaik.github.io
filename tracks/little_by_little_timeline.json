{
  "track": "Little by Little",
  "durationSec": 117.96,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "en",
      "startSec": 5.02,
      "endSec": 7.38,
      "text": "I wake up early in the morning"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "ru",
      "startSec": 7.38,
      "endSec": 9.84,
      "text": "Я просыпаюсь рано утром"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "en",
      "startSec": 9.84,
      "endSec": 12.00,
      "text": "I look outside and see the sun"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "ru",
      "startSec": 12.00,
      "endSec": 14.28,
      "text": "Я смотрю наружу и вижу солнце"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "en",
      "startSec": 14.28,
      "endSec": 16.66,
      "text": "I make some coffee in the kitchen"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "ru",
      "startSec": 16.66,
      "endSec": 18.52,
      "text": "Я готовлю кофе на кухне"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "en",
      "startSec": 18.52,
      "endSec": 20.90,
      "text": "And think about the things I've done"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "ru",
      "startSec": 20.90,
      "endSec": 23.58,
      "text": "И думаю о том, что я сделал"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "en",
      "startSec": 23.58,
      "endSec": 24.84,
      "text": "I have a busy day ahead"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "ru",
      "startSec": 24.84,
      "endSec": 27.20,
      "text": "У меня впереди напряжённый день"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "en",
      "startSec": 27.20,
      "endSec": 29.72,
      "text": "But I don't want to rush"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "ru",
      "startSec": 29.72,
      "endSec": 32.74,
      "text": "Но я не хочу спешить"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "en",
      "startSec": 32.74,
      "endSec": 34.00,
      "text": "I take a breath and start again"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "ru",
      "startSec": 34.00,
      "endSec": 36.74,
      "text": "Я делаю вдох и начинаю снова"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "en",
      "startSec": 36.74,
      "endSec": 39.26,
      "text": "I know I can do enough"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "ru",
      "startSec": 39.26,
      "endSec": 41.27,
      "text": "Я знаю, что я справлюсь"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "en",
      "startSec": 41.27,
      "endSec": 43.63,
      "text": "Sometimes life is moving fast"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "ru",
      "startSec": 43.63,
      "endSec": 45.97,
      "text": "Иногда жизнь движется быстро"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "en",
      "startSec": 45.97,
      "endSec": 48.17,
      "text": "And I don't know what comes next"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "ru",
      "startSec": 48.17,
      "endSec": 50.41,
      "text": "И я не знаю, что будет дальше"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "en",
      "startSec": 50.41,
      "endSec": 52.75,
      "text": "But I can take it step by step"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "ru",
      "startSec": 52.75,
      "endSec": 55.17,
      "text": "Но я могу идти шаг за шагом"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "en",
      "startSec": 55.17,
      "endSec": 57.37,
      "text": "And give myself a little rest"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "ru",
      "startSec": 57.37,
      "endSec": 60.79,
      "text": "И дать себе немного отдохнуть"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "en",
      "startSec": 60.79,
      "endSec": 62.75,
      "text": "I want to learn, I want to grow"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "ru",
      "startSec": 62.75,
      "endSec": 65.45,
      "text": "Я хочу учиться, я хочу развиваться"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "en",
      "startSec": 65.45,
      "endSec": 67.39,
      "text": "I want to see how far I can go"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "ru",
      "startSec": 67.39,
      "endSec": 70.15,
      "text": "Я хочу увидеть, как далеко я могу зайти"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "en",
      "startSec": 70.15,
      "endSec": 71.99,
      "text": "Every mistake can teach me more"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "ru",
      "startSec": 71.99,
      "endSec": 74.87,
      "text": "Каждая ошибка может многому меня научить"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "en",
      "startSec": 74.87,
      "endSec": 76.65,
      "text": "Every new day opens a door"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "ru",
      "startSec": 76.65,
      "endSec": 79.93,
      "text": "Каждый новый день открывает дверь"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "en",
      "startSec": 79.93,
      "endSec": 82.03,
      "text": "I don't need to know it all"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "ru",
      "startSec": 82.03,
      "endSec": 84.73,
      "text": "Мне не нужно знать всё"
    },
    {
      "index": 34,
      "line": 18,
      "lang": "en",
      "startSec": 84.73,
      "endSec": 86.65,
      "text": "I only need to start"
    },
    {
      "index": 35,
      "line": 18,
      "lang": "ru",
      "startSec": 86.65,
      "endSec": 88.29,
      "text": "Мне нужно только начать"
    },
    {
      "index": 36,
      "line": 19,
      "lang": "en",
      "startSec": 88.29,
      "endSec": 90.85,
      "text": "Little by little, day by day"
    },
    {
      "index": 37,
      "line": 19,
      "lang": "ru",
      "startSec": 90.85,
      "endSec": 92.89,
      "text": "Постепенно, день за днём"
    },
    {
      "index": 38,
      "line": 20,
      "lang": "en",
      "startSec": 92.89,
      "endSec": 95.39,
      "text": "I'm getting better where I am"
    },
    {
      "index": 39,
      "line": 20,
      "lang": "ru",
      "startSec": 95.39,
      "endSec": 117.96,
      "text": "Я становлюсь лучше там, где я сейчас"
    }
  ],
