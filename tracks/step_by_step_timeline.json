{
  "track": "step_by_step",
  "durationSec": 185.16,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 1.1,
      "endSec": 3.37,
      "text": "Я учусь чему-то новому"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 3.37,
      "endSec": 5.7,
      "text": "I’m learning something new"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 5.7,
      "endSec": 8.03,
      "text": "Каждый день понемногу"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 8.03,
      "endSec": 10.37,
      "text": "A little every day"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 10.37,
      "endSec": 12.03,
      "text": "Иногда мне трудно"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 12.03,
      "endSec": 13.23,
      "text": "Sometimes it’s hard"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 13.23,
      "endSec": 14.93,
      "text": "Но я хочу продолжать"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 14.93,
      "endSec": 20.17,
      "text": "But I want to carry on"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 20.17,
      "endSec": 21.53,
      "text": "Я делаю ошибки"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 21.53,
      "endSec": 22.5,
      "text": "I make mistakes"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 22.5,
      "endSec": 23.63,
      "text": "И не знаю всех слов"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 23.63,
      "endSec": 25.3,
      "text": "And I don’t know all the words"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 25.3,
      "endSec": 26.5,
      "text": "Но я пробую снова"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 26.5,
      "endSec": 27.47,
      "text": "But I try again"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 27.47,
      "endSec": 28.8,
      "text": "И становлюсь сильней"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 28.8,
      "endSec": 32.5,
      "text": "And I get stronger"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 32.5,
      "endSec": 33.6,
      "text": "Шаг за шагом"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 33.6,
      "endSec": 34.83,
      "text": "Step by step"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 34.83,
      "endSec": 35.7,
      "text": "Я иду вперёд"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 35.7,
      "endSec": 36.93,
      "text": "I move ahead"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 36.93,
      "endSec": 38.13,
      "text": "Сегодня немного"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 38.13,
      "endSec": 39.3,
      "text": "A little today"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 39.3,
      "endSec": 40.43,
      "text": "Завтра ещё больше"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 40.43,
      "endSec": 42.03,
      "text": "A little more tomorrow"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 42.03,
      "endSec": 43.23,
      "text": "Я ещё не умею"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 43.23,
      "endSec": 44.2,
      "text": "I can’t do it yet"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 44.2,
      "endSec": 45.47,
      "text": "Но я учусь каждый день"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 45.47,
      "endSec": 46.63,
      "text": "But I learn every day"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 46.63,
      "endSec": 47.77,
      "text": "Маленький успех"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 47.77,
      "endSec": 48.97,
      "text": "A small success"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 48.97,
      "endSec": 50.37,
      "text": "Даёт мне силы"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 50.37,
      "endSec": 59.3,
      "text": "Gives me strength"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 59.3,
      "endSec": 61.03,
      "text": "Я учу новые слова"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 61.03,
      "endSec": 62.07,
      "text": "I learn new words"
    },
    {
      "index": 34,
      "line": 18,
      "lang": "ru",
      "startSec": 62.07,
      "endSec": 63.33,
      "text": "И повторяю их вслух"
    },
    {
      "index": 35,
      "line": 18,
      "lang": "en",
      "startSec": 63.33,
      "endSec": 64.37,
      "text": "And say them out loud"
    },
    {
      "index": 36,
      "line": 19,
      "lang": "ru",
      "startSec": 64.37,
      "endSec": 65.67,
      "text": "Сначала я забываю"
    },
    {
      "index": 37,
      "line": 19,
      "lang": "en",
      "startSec": 65.67,
      "endSec": 66.77,
      "text": "At first, I forget"
    },
    {
      "index": 38,
      "line": 20,
      "lang": "ru",
      "startSec": 66.77,
      "endSec": 67.97,
      "text": "Но потом вспоминаю"
    },
    {
      "index": 39,
      "line": 20,
      "lang": "en",
      "startSec": 67.97,
      "endSec": 69.7,
      "text": "But then I remember"
    },
    {
      "index": 40,
      "line": 21,
      "lang": "ru",
      "startSec": 69.7,
      "endSec": 71.97,
      "text": "Я играю простую песню"
    },
    {
      "index": 41,
      "line": 21,
      "lang": "en",
      "startSec": 71.97,
      "endSec": 74.27,
      "text": "I play a simple song"
    },
    {
      "index": 42,
      "line": 22,
      "lang": "ru",
      "startSec": 74.27,
      "endSec": 76.03,
      "text": "И сбиваюсь иногда"
    },
    {
      "index": 43,
      "line": 22,
      "lang": "en",
      "startSec": 76.03,
      "endSec": 79.47,
      "text": "And sometimes I lose my way"
    },
    {
      "index": 44,
      "line": 23,
      "lang": "ru",
      "startSec": 79.47,
      "endSec": 80.93,
      "text": "Но сегодня я смог"
    },
    {
      "index": 45,
      "line": 23,
      "lang": "en",
      "startSec": 80.93,
      "endSec": 82.77,
      "text": "But today I did it"
    },
    {
      "index": 46,
      "line": 24,
      "lang": "ru",
      "startSec": 82.77,
      "endSec": 85.27,
      "text": "Сыграть её до конца"
    },
    {
      "index": 47,
      "line": 24,
      "lang": "en",
      "startSec": 85.27,
      "endSec": 87.8,
      "text": "I played it to the end"
    },
    {
      "index": 48,
      "line": 25,
      "lang": "ru",
      "startSec": 87.8,
      "endSec": 88.9,
      "text": "Шаг за шагом"
    },
    {
      "index": 49,
      "line": 25,
      "lang": "en",
      "startSec": 88.9,
      "endSec": 90.17,
      "text": "Step by step"
    },
    {
      "index": 50,
      "line": 26,
      "lang": "ru",
      "startSec": 90.17,
      "endSec": 91.0,
      "text": "Я иду вперёд"
    },
    {
      "index": 51,
      "line": 26,
      "lang": "en",
      "startSec": 91.0,
      "endSec": 92.23,
      "text": "I move ahead"
    },
    {
      "index": 52,
      "line": 27,
      "lang": "ru",
      "startSec": 92.23,
      "endSec": 93.43,
      "text": "Сегодня немного"
    },
    {
      "index": 53,
      "line": 27,
      "lang": "en",
      "startSec": 93.43,
      "endSec": 94.57,
      "text": "A little today"
    },
    {
      "index": 54,
      "line": 28,
      "lang": "ru",
      "startSec": 94.57,
      "endSec": 95.73,
      "text": "Завтра ещё больше"
    },
    {
      "index": 55,
      "line": 28,
      "lang": "en",
      "startSec": 95.73,
      "endSec": 97.3,
      "text": "A little more tomorrow"
    },
    {
      "index": 56,
      "line": 29,
      "lang": "ru",
      "startSec": 97.3,
      "endSec": 98.43,
      "text": "Я ещё не умею"
    },
    {
      "index": 57,
      "line": 29,
      "lang": "en",
      "startSec": 98.43,
      "endSec": 99.47,
      "text": "I can’t do it yet"
    },
    {
      "index": 58,
      "line": 30,
      "lang": "ru",
      "startSec": 99.47,
      "endSec": 100.73,
      "text": "Но я учусь каждый день"
    },
    {
      "index": 59,
      "line": 30,
      "lang": "en",
      "startSec": 100.73,
      "endSec": 101.9,
      "text": "But I learn every day"
    },
    {
      "index": 60,
      "line": 31,
      "lang": "ru",
      "startSec": 101.9,
      "endSec": 103.03,
      "text": "Маленький успех"
    },
    {
      "index": 61,
      "line": 31,
      "lang": "en",
      "startSec": 103.03,
      "endSec": 104.2,
      "text": "A small success"
    },
    {
      "index": 62,
      "line": 32,
      "lang": "ru",
      "startSec": 104.2,
      "endSec": 105.63,
      "text": "Даёт мне силы"
    },
    {
      "index": 63,
      "line": 32,
      "lang": "en",
      "startSec": 105.63,
      "endSec": 114.17,
      "text": "Gives me strength"
    },
    {
      "index": 64,
      "line": 33,
      "lang": "ru",
      "startSec": 116.27,
      "endSec": 118.47,
      "text": "Иногда я устаю"
    },
    {
      "index": 65,
      "line": 33,
      "lang": "en",
      "startSec": 118.47,
      "endSec": 120.87,
      "text": "Sometimes I get tired"
    },
    {
      "index": 66,
      "line": 34,
      "lang": "ru",
      "startSec": 120.87,
      "endSec": 122.57,
      "text": "И хочу всё бросить"
    },
    {
      "index": 67,
      "line": 34,
      "lang": "en",
      "startSec": 122.57,
      "endSec": 125.43,
      "text": "And I want to give up"
    },
    {
      "index": 68,
      "line": 35,
      "lang": "ru",
      "startSec": 125.43,
      "endSec": 127.57,
      "text": "Но я делаю ещё один шаг"
    },
    {
      "index": 69,
      "line": 35,
      "lang": "en",
      "startSec": 127.57,
      "endSec": 129.97,
      "text": "But I take one more step"
    },
    {
      "index": 70,
      "line": 36,
      "lang": "ru",
      "startSec": 129.97,
      "endSec": 132.23,
      "text": "И снова начинаю"
    },
    {
      "index": 71,
      "line": 36,
      "lang": "en",
      "startSec": 132.23,
      "endSec": 138.23,
      "text": "And start again"
    },
    {
      "index": 72,
      "line": 37,
      "lang": "ru",
      "startSec": 138.23,
      "endSec": 139.3,
      "text": "Шаг за шагом"
    },
    {
      "index": 73,
      "line": 37,
      "lang": "en",
      "startSec": 139.3,
      "endSec": 140.17,
      "text": "Step by step"
    },
    {
      "index": 74,
      "line": 38,
      "lang": "ru",
      "startSec": 140.17,
      "endSec": 141.4,
      "text": "Я иду вперёд"
    },
    {
      "index": 75,
      "line": 38,
      "lang": "en",
      "startSec": 141.4,
      "endSec": 143.67,
      "text": "I move ahead"
    },
    {
      "index": 76,
      "line": 39,
      "lang": "ru",
      "startSec": 143.67,
      "endSec": 145.93,
      "text": "Я вижу свой прогресс"
    },
    {
      "index": 77,
      "line": 39,
      "lang": "en",
      "startSec": 145.93,
      "endSec": 148.23,
      "text": "I can see my progress"
    },
    {
      "index": 78,
      "line": 40,
      "lang": "ru",
      "startSec": 148.23,
      "endSec": 150.53,
      "text": "И знаю, что могу"
    },
    {
      "index": 79,
      "line": 40,
      "lang": "en",
      "startSec": 150.53,
      "endSec": 156.73,
      "text": "And I know I can"
    },
    {
      "index": 80,
      "line": 41,
      "lang": "ru",
      "startSec": 156.73,
      "endSec": 157.87,
      "text": "Я ещё не умею"
    },
    {
      "index": 81,
      "line": 41,
      "lang": "en",
      "startSec": 157.87,
      "endSec": 159.0,
      "text": "I can’t do it yet"
    },
    {
      "index": 82,
      "line": 42,
      "lang": "ru",
      "startSec": 159.0,
      "endSec": 160.13,
      "text": "Но скоро научусь"
    },
    {
      "index": 83,
      "line": 42,
      "lang": "en",
      "startSec": 160.13,
      "endSec": 164.13,
      "text": "But soon I will learn"
    },
    {
      "index": 84,
      "line": 43,
      "lang": "ru",
      "startSec": 164.13,
      "endSec": 166.37,
      "text": "Маленький успех"
    },
    {
      "index": 85,
      "line": 43,
      "lang": "en",
      "startSec": 166.37,
      "endSec": 168.33,
      "text": "A small success"
    },
    {
      "index": 86,
      "line": 44,
      "lang": "ru",
      "startSec": 168.33,
      "endSec": 171.17,
      "text": "Помогает мне расти"
    },
    {
      "index": 87,
      "line": 44,
      "lang": "en",
      "startSec": 171.17,
      "endSec": 185.16,
      "text": "Helps me grow"
    }
  ],
