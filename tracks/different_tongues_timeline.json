{
  "track": "different_tongues",
  "durationSec": 151.12,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 19.55,
      "endSec": 22.02,
      "text": "Я приехал в город легенд."
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 22.02,
      "endSec": 25.13,
      "text": "I'd come to a city steeped in legend."
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 25.13,
      "endSec": 26.89,
      "text": "Фасады ожили в темноте."
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 26.89,
      "endSec": 29.36,
      "text": "The façades came alive in the dark."
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 29.36,
      "endSec": 31.36,
      "text": "Я не знал здесь ни души."
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 31.36,
      "endSec": 33.91,
      "text": "I knew not a soul in town."
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 33.91,
      "endSec": 36.22,
      "text": "Ни слова на местном наречии."
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 36.22,
      "endSec": 38.7,
      "text": "Not a word of the local dialect."
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 38.7,
      "endSec": 40.85,
      "text": "Но окликнула незнакомка."
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 40.85,
      "endSec": 43.72,
      "text": "Yet a stranger hailed me there."
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 43.72,
      "endSec": 45.96,
      "text": "Она сказала что-то — я не понял."
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 45.96,
      "endSec": 48.67,
      "text": "She said something; I couldn't make it out."
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 48.67,
      "endSec": 50.98,
      "text": "Но бас перевёл без труда."
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 50.98,
      "endSec": 53.7,
      "text": "But the bass translated it with ease."
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 53.7,
      "endSec": 55.61,
      "text": "Ритму не нужны словари."
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 55.61,
      "endSec": 59.28,
      "text": "Rhythm has no use for dictionaries."
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 59.28,
      "endSec": 61.84,
      "text": "Разные языки — один ритм!"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 61.84,
      "endSec": 64.07,
      "text": "Different tongues, one rhythm!"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 64.07,
      "endSec": 66.46,
      "text": "Танцуем поверх границ!"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 66.46,
      "endSec": 69.25,
      "text": "We dance across the borders!"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 69.25,
      "endSec": 70.77,
      "text": "Каждый хранит свой акцент."
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 70.77,
      "endSec": 73.17,
      "text": "Everyone keeps their accent."
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 73.17,
      "endSec": 75.0,
      "text": "Так рождается общий язык."
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 75.0,
      "endSec": 78.11,
      "text": "That's how a common language is born."
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 78.11,
      "endSec": 80.58,
      "text": "Мы шли по старой брусчатке."
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 80.58,
      "endSec": 82.98,
      "text": "We walked along the old cobbles."
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 82.98,
      "endSec": 85.29,
      "text": "Рядом заиграл уличный скрипач."
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 85.29,
      "endSec": 87.77,
      "text": "A street violinist struck up nearby."
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 87.77,
      "endSec": 89.92,
      "text": "Она узнала мотив из детства."
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 89.92,
      "endSec": 92.87,
      "text": "She recognised a tune from her childhood."
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 92.87,
      "endSec": 94.79,
      "text": "Я узнал его тоже."
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 94.79,
      "endSec": 98.3,
      "text": "I recognised it too."
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 98.3,
      "endSec": 100.93,
      "text": "Обе мелодии — на одной ноте."
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 100.93,
      "endSec": 102.85,
      "text": "Both melodies hinged on one note."
    },
    {
      "index": 34,
      "line": 18,
      "lang": "ru",
      "startSec": 102.85,
      "endSec": 105.24,
      "text": "Культура — диалог вопреки векАм."
    },
    {
      "index": 35,
      "line": 18,
      "lang": "en",
      "startSec": 105.24,
      "endSec": 108.51,
      "text": "Culture is a dialogue that defies the ages."
    },
    {
      "index": 36,
      "line": 19,
      "lang": "ru",
      "startSec": 108.51,
      "endSec": 110.5,
      "text": "Мы не бальзамируем наследие."
    },
    {
      "index": 37,
      "line": 19,
      "lang": "en",
      "startSec": 110.5,
      "endSec": 112.5,
      "text": "We don't embalm our heritage."
    },
    {
      "index": 38,
      "line": 20,
      "lang": "ru",
      "startSec": 112.5,
      "endSec": 114.25,
      "text": "Мы на нём строим будущее."
    },
    {
      "index": 39,
      "line": 20,
      "lang": "en",
      "startSec": 114.25,
      "endSec": 118.4,
      "text": "We build the future upon it."
    },
    {
      "index": 40,
      "line": 21,
      "lang": "ru",
      "startSec": 118.4,
      "endSec": 120.8,
      "text": "Разные языки — один ритм!"
    },
    {
      "index": 41,
      "line": 21,
      "lang": "en",
      "startSec": 120.8,
      "endSec": 123.59,
      "text": "Different tongues, one rhythm!"
    },
    {
      "index": 42,
      "line": 22,
      "lang": "ru",
      "startSec": 123.59,
      "endSec": 125.5,
      "text": "Так рождается общий язык."
    },
    {
      "index": 43,
      "line": 22,
      "lang": "en",
      "startSec": 125.5,
      "endSec": 151.12,
      "text": "That's how a common language is born."
    }
  ],
