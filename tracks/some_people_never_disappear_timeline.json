{
  "track": "some_people_never_disappear",
  "durationSec": 174.0,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 0.93,
      "endSec": 4.5,
      "text": "Я встретил тебя вчера на улице"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 4.5,
      "endSec": 7.83,
      "text": "I saw you yesterday on the street"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 7.83,
      "endSec": 9.9,
      "text": "После стольких лет"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 9.9,
      "endSec": 11.67,
      "text": "After all these years"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 11.67,
      "endSec": 15.27,
      "text": "Ты улыбнулась мне и сказала: «Привет»"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 15.27,
      "endSec": 17.83,
      "text": "You smiled at me and said, “Hey”"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 17.83,
      "endSec": 19.5,
      "text": "Как будто всё было вчера"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 19.5,
      "endSec": 21.93,
      "text": "As if it was yesterday"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 21.93,
      "endSec": 23.5,
      "text": "Мы немного поговорили"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 23.5,
      "endSec": 25.67,
      "text": "We talked for a little while"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 25.67,
      "endSec": 27.97,
      "text": "О том, как всё изменилось"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 27.97,
      "endSec": 29.97,
      "text": "About how things have changed"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 29.97,
      "endSec": 31.67,
      "text": "Ты переехала в другой город"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 31.67,
      "endSec": 34.23,
      "text": "You moved to another town"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 34.23,
      "endSec": 36.47,
      "text": "А я остался здесь"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 36.47,
      "endSec": 38.47,
      "text": "And I stayed here"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 38.47,
      "endSec": 40.33,
      "text": "Странно встретить тебя снова"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 40.33,
      "endSec": 43.23,
      "text": "It feels strange to see you again"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 43.23,
      "endSec": 44.7,
      "text": "После всего, что было"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 44.7,
      "endSec": 46.93,
      "text": "After all that happened"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 46.93,
      "endSec": 48.47,
      "text": "Но стоило нам заговорить"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 48.47,
      "endSec": 50.97,
      "text": "But once we started talking"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 50.97,
      "endSec": 52.33,
      "text": "Всё стало как раньше"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 52.33,
      "endSec": 57.17,
      "text": "Everything felt like before"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 57.17,
      "endSec": 59.63,
      "text": "Некоторые люди не исчезают"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 59.63,
      "endSec": 62.27,
      "text": "Some people never disappear"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 62.27,
      "endSec": 64.07,
      "text": "Даже если проходят годы"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 64.07,
      "endSec": 65.8,
      "text": "Even when the years go by"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 65.8,
      "endSec": 68.37,
      "text": "Мы пошли разными дорогами"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 68.37,
      "endSec": 69.87,
      "text": "We went our separate ways"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 69.87,
      "endSec": 72.43,
      "text": "Но ты всё ещё важна мне"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 72.43,
      "endSec": 74.43,
      "text": "But you still matter to me"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 74.43,
      "endSec": 76.03,
      "text": "Я не знаю, что будет дальше"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 76.03,
      "endSec": 78.33,
      "text": "I don’t know what comes next"
    },
    {
      "index": 34,
      "line": 18,
      "lang": "ru",
      "startSec": 78.33,
      "endSec": 80.33,
      "text": "И, наверное, это нормально"
    },
    {
      "index": 35,
      "line": 18,
      "lang": "en",
      "startSec": 80.33,
      "endSec": 82.13,
      "text": "And I guess that’s okay"
    },
    {
      "index": 36,
      "line": 19,
      "lang": "ru",
      "startSec": 82.13,
      "endSec": 84.57,
      "text": "Иногда прошлое возвращается"
    },
    {
      "index": 37,
      "line": 19,
      "lang": "en",
      "startSec": 84.57,
      "endSec": 86.33,
      "text": "Sometimes the past comes back"
    },
    {
      "index": 38,
      "line": 20,
      "lang": "ru",
      "startSec": 86.33,
      "endSec": 88.43,
      "text": "Чтоб напомнить, кто мы есть"
    },
    {
      "index": 39,
      "line": 20,
      "lang": "en",
      "startSec": 88.43,
      "endSec": 91.2,
      "text": "To remind us who we are"
    },
    {
      "index": 40,
      "line": 21,
      "lang": "ru",
      "startSec": 91.2,
      "endSec": 92.8,
      "text": "Ты спросила, как моя жизнь"
    },
    {
      "index": 41,
      "line": 21,
      "lang": "en",
      "startSec": 92.8,
      "endSec": 94.8,
      "text": "You asked me how my life was"
    },
    {
      "index": 42,
      "line": 22,
      "lang": "ru",
      "startSec": 94.8,
      "endSec": 96.83,
      "text": "Я сказал: «Многое изменилось»"
    },
    {
      "index": 43,
      "line": 22,
      "lang": "en",
      "startSec": 96.83,
      "endSec": 98.6,
      "text": "I said, “A lot has changed”"
    },
    {
      "index": 44,
      "line": 23,
      "lang": "ru",
      "startSec": 98.6,
      "endSec": 100.4,
      "text": "Я нашёл новую работу"
    },
    {
      "index": 45,
      "line": 23,
      "lang": "en",
      "startSec": 100.4,
      "endSec": 102.4,
      "text": "I found a new job"
    },
    {
      "index": 46,
      "line": 24,
      "lang": "ru",
      "startSec": 102.4,
      "endSec": 104.43,
      "text": "И начал всё сначала"
    },
    {
      "index": 47,
      "line": 24,
      "lang": "en",
      "startSec": 104.43,
      "endSec": 106.37,
      "text": "And started over again"
    },
    {
      "index": 48,
      "line": 25,
      "lang": "ru",
      "startSec": 106.37,
      "endSec": 108.03,
      "text": "Ты рассказала о своей семье"
    },
    {
      "index": 49,
      "line": 25,
      "lang": "en",
      "startSec": 108.03,
      "endSec": 109.97,
      "text": "You told me about your family"
    },
    {
      "index": 50,
      "line": 26,
      "lang": "ru",
      "startSec": 109.97,
      "endSec": 112.07,
      "text": "И о местах, где побывала"
    },
    {
      "index": 51,
      "line": 26,
      "lang": "en",
      "startSec": 112.07,
      "endSec": 114.07,
      "text": "And about the places you’ve been"
    },
    {
      "index": 52,
      "line": 27,
      "lang": "ru",
      "startSec": 114.07,
      "endSec": 116.17,
      "text": "Мы смеялись над старыми историями"
    },
    {
      "index": 53,
      "line": 27,
      "lang": "en",
      "startSec": 116.17,
      "endSec": 118.27,
      "text": "We laughed about our old stories"
    },
    {
      "index": 54,
      "line": 28,
      "lang": "ru",
      "startSec": 118.27,
      "endSec": 120.7,
      "text": "Которые помним до сих пор"
    },
    {
      "index": 55,
      "line": 28,
      "lang": "en",
      "startSec": 120.7,
      "endSec": 123.23,
      "text": "That we still remember"
    },
    {
      "index": 56,
      "line": 29,
      "lang": "ru",
      "startSec": 123.23,
      "endSec": 125.77,
      "text": "Мы думали, что знаем будущее"
    },
    {
      "index": 57,
      "line": 29,
      "lang": "en",
      "startSec": 125.77,
      "endSec": 127.3,
      "text": "We thought we knew the future"
    },
    {
      "index": 58,
      "line": 30,
      "lang": "ru",
      "startSec": 127.3,
      "endSec": 129.33,
      "text": "Но жизнь пошла своим путём"
    },
    {
      "index": 59,
      "line": 30,
      "lang": "en",
      "startSec": 129.33,
      "endSec": 131.4,
      "text": "But life went its own way"
    },
    {
      "index": 60,
      "line": 31,
      "lang": "ru",
      "startSec": 131.4,
      "endSec": 133.4,
      "text": "Мы потеряли связь на годы"
    },
    {
      "index": 61,
      "line": 31,
      "lang": "en",
      "startSec": 133.4,
      "endSec": 135.17,
      "text": "We lost touch for years"
    },
    {
      "index": 62,
      "line": 32,
      "lang": "ru",
      "startSec": 135.17,
      "endSec": 137.23,
      "text": "Но друг друга не забыли"
    },
    {
      "index": 63,
      "line": 32,
      "lang": "en",
      "startSec": 137.23,
      "endSec": 139.47,
      "text": "But we never forgot each other"
    },
    {
      "index": 64,
      "line": 33,
      "lang": "ru",
      "startSec": 139.47,
      "endSec": 142.03,
      "text": "Некоторые люди не исчезают"
    },
    {
      "index": 65,
      "line": 33,
      "lang": "en",
      "startSec": 142.03,
      "endSec": 143.57,
      "text": "Some people never disappear"
    },
    {
      "index": 66,
      "line": 34,
      "lang": "ru",
      "startSec": 143.57,
      "endSec": 145.33,
      "text": "Даже если проходят годы"
    },
    {
      "index": 67,
      "line": 34,
      "lang": "en",
      "startSec": 145.33,
      "endSec": 147.13,
      "text": "Even when the years go by"
    },
    {
      "index": 68,
      "line": 35,
      "lang": "ru",
      "startSec": 147.13,
      "endSec": 149.67,
      "text": "Мы пошли разными дорогами"
    },
    {
      "index": 69,
      "line": 35,
      "lang": "en",
      "startSec": 149.67,
      "endSec": 151.2,
      "text": "We went our separate ways"
    },
    {
      "index": 70,
      "line": 36,
      "lang": "ru",
      "startSec": 151.2,
      "endSec": 153.7,
      "text": "Но ты всё ещё важна мне"
    },
    {
      "index": 71,
      "line": 36,
      "lang": "en",
      "startSec": 153.7,
      "endSec": 156.3,
      "text": "But you still matter to me"
    },
    {
      "index": 72,
      "line": 37,
      "lang": "ru",
      "startSec": 156.3,
      "endSec": 157.87,
      "text": "Я не знаю, что будет дальше"
    },
    {
      "index": 73,
      "line": 37,
      "lang": "en",
      "startSec": 157.87,
      "endSec": 160.33,
      "text": "I don’t know what comes next"
    },
    {
      "index": 74,
      "line": 38,
      "lang": "ru",
      "startSec": 160.33,
      "endSec": 161.83,
      "text": "И, наверное, это нормально"
    },
    {
      "index": 75,
      "line": 38,
      "lang": "en",
      "startSec": 161.83,
      "endSec": 164.4,
      "text": "And I guess that’s okay"
    },
    {
      "index": 76,
      "line": 39,
      "lang": "ru",
      "startSec": 164.4,
      "endSec": 166.83,
      "text": "Иногда прошлое возвращается"
    },
    {
      "index": 77,
      "line": 39,
      "lang": "en",
      "startSec": 166.83,
      "endSec": 168.6,
      "text": "Sometimes the past comes back"
    },
    {
      "index": 78,
      "line": 40,
      "lang": "ru",
      "startSec": 168.6,
      "endSec": 170.73,
      "text": "Чтоб напомнить, кто мы есть"
    },
    {
      "index": 79,
