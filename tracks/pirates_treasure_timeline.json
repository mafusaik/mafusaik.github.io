{
  "track": "pirate_s_treasure",
  "durationSec": 92.8,
  "cues": [
    {
      "index": 0,
      "line": 1,
      "lang": "ru",
      "startSec": 9.18,
      "endSec": 11.09,
      "text": "Мы пираты, в путь пора!"
    },
    {
      "index": 1,
      "line": 1,
      "lang": "en",
      "startSec": 11.09,
      "endSec": 13.48,
      "text": "We’re pirates, time to go!"
    },
    {
      "index": 2,
      "line": 2,
      "lang": "ru",
      "startSec": 13.48,
      "endSec": 15.24,
      "text": "Карта есть, ура, ура!"
    },
    {
      "index": 3,
      "line": 2,
      "lang": "en",
      "startSec": 15.24,
      "endSec": 17.79,
      "text": "We have a map, hooray, hooray!"
    },
    {
      "index": 4,
      "line": 3,
      "lang": "ru",
      "startSec": 17.79,
      "endSec": 19.87,
      "text": "Не спеша идём вперёд"
    },
    {
      "index": 5,
      "line": 3,
      "lang": "en",
      "startSec": 19.87,
      "endSec": 22.18,
      "text": "Slowly, we walk ahead"
    },
    {
      "index": 6,
      "line": 4,
      "lang": "ru",
      "startSec": 22.18,
      "endSec": 24.02,
      "text": "Вот река, держись, пират!"
    },
    {
      "index": 7,
      "line": 4,
      "lang": "en",
      "startSec": 24.02,
      "endSec": 26.49,
      "text": "Here’s the river, keep going, pirate!"
    },
    {
      "index": 8,
      "line": 5,
      "lang": "ru",
      "startSec": 26.49,
      "endSec": 28.72,
      "text": "Йо-хо-хо, мы ищем клад!"
    },
    {
      "index": 9,
      "line": 5,
      "lang": "en",
      "startSec": 28.72,
      "endSec": 30.8,
      "text": "Yo-ho-ho, we're look for treasure!"
    },
    {
      "index": 10,
      "line": 6,
      "lang": "ru",
      "startSec": 30.8,
      "endSec": 33.03,
      "text": "Будь внимателен, пират!"
    },
    {
      "index": 11,
      "line": 6,
      "lang": "en",
      "startSec": 33.03,
      "endSec": 34.95,
      "text": "Pay attention, pirate!"
    },
    {
      "index": 12,
      "line": 7,
      "lang": "ru",
      "startSec": 34.95,
      "endSec": 37.42,
      "text": "Копай, копай, копай!"
    },
    {
      "index": 13,
      "line": 7,
      "lang": "en",
      "startSec": 37.42,
      "endSec": 47.42,
      "text": "Dig, dig, dig!"
    },
    {
      "index": 14,
      "line": 8,
      "lang": "ru",
      "startSec": 47.87,
      "endSec": 50.27,
      "text": "Под камень загляни!"
    },
    {
      "index": 15,
      "line": 8,
      "lang": "en",
      "startSec": 50.27,
      "endSec": 51.86,
      "text": "Look under the rock!"
    },
    {
      "index": 16,
      "line": 9,
      "lang": "ru",
      "startSec": 51.86,
      "endSec": 54.1,
      "text": "Возле бочки поищи!"
    },
    {
      "index": 17,
      "line": 9,
      "lang": "en",
      "startSec": 54.1,
      "endSec": 56.25,
      "text": "Search next to the barrel!"
    },
    {
      "index": 18,
      "line": 10,
      "lang": "ru",
      "startSec": 56.25,
      "endSec": 58.4,
      "text": "За холмом погляди!"
    },
    {
      "index": 19,
      "line": 10,
      "lang": "en",
      "startSec": 58.4,
      "endSec": 60.56,
      "text": "Look behind the hill!"
    },
    {
      "index": 20,
      "line": 11,
      "lang": "ru",
      "startSec": 60.56,
      "endSec": 62.87,
      "text": "И пещеру обыщи!"
    },
    {
      "index": 21,
      "line": 11,
      "lang": "en",
      "startSec": 62.87,
      "endSec": 65.43,
      "text": "And search the cave!"
    },
    {
      "index": 22,
      "line": 12,
      "lang": "ru",
      "startSec": 65.43,
      "endSec": 67.02,
      "text": "Стоп! Замри!"
    },
    {
      "index": 23,
      "line": 12,
      "lang": "en",
      "startSec": 67.02,
      "endSec": 67.9,
      "text": "Stop! Freeze!"
    },
    {
      "index": 24,
      "line": 13,
      "lang": "ru",
      "startSec": 67.9,
      "endSec": 69.1,
      "text": "Сундук в песке!"
    },
    {
      "index": 25,
      "line": 13,
      "lang": "en",
      "startSec": 69.1,
      "endSec": 70.61,
      "text": "The chest is in the sand!"
    },
    {
      "index": 26,
      "line": 14,
      "lang": "ru",
      "startSec": 70.61,
      "endSec": 71.97,
      "text": "Открой его!"
    },
    {
      "index": 27,
      "line": 14,
      "lang": "en",
      "startSec": 71.97,
      "endSec": 74.04,
      "text": "Open it!"
    },
    {
      "index": 28,
      "line": 15,
      "lang": "ru",
      "startSec": 74.04,
      "endSec": 76.2,
      "text": "Йо-хо-хо, мы нашли клад!"
    },
    {
      "index": 29,
      "line": 15,
      "lang": "en",
      "startSec": 76.2,
      "endSec": 78.27,
      "text": "Yo-ho-ho, we found the treasure!"
    },
    {
      "index": 30,
      "line": 16,
      "lang": "ru",
      "startSec": 78.27,
      "endSec": 79.31,
      "text": "Ура, пираты!"
    },
    {
      "index": 31,
      "line": 16,
      "lang": "en",
      "startSec": 79.31,
      "endSec": 80.5,
      "text": "Hooray, pirates!"
    },
    {
      "index": 32,
      "line": 17,
      "lang": "ru",
      "startSec": 80.5,
      "endSec": 82.66,
      "text": "Йо-хо-хо, ура!"
    },
    {
      "index": 33,
      "line": 17,
      "lang": "en",
      "startSec": 82.66,
      "endSec": 92.8,
      "text": "Yo-ho-ho, hooray!"
    }
  ],
